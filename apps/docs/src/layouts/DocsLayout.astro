            <span class="item-meta">Framework</span>
          </a>

          <a
            href="/docs#persistence"
            class="search-result-item"
            data-text="declarative persistence persist url local storage query params"
          >
            <span>Declarative State Persistence</span>
            <span class="item-meta">Crown Feature</span>
          </a>
          <a
            href="/docs#cross-tab"
            class="search-result-item"
            data-text="cross tab broadcast sync multi tab broadcastchannel synchronization"
          >
            <span>Cross-Tab Broadcast Sync</span>
            <span class="item-meta">Crown Feature</span>
          </a>
          <a
            href="/docs#ai-introspection"
            class="search-result-item"
            data-text="ai introspection inspectai protocol copilot cursor llm schema"
          >
            <span>AI Introspection Protocol</span>
            <span class="item-meta">nnui.ai.v1</span>
          </a>
          <a
            href="/llms"
            class="search-result-item"
            data-text="llms.txt ai assistant context cursor copilot claude chatgpt windsurf prompt specification rules"
          >
            <span>AI Assistant Context (llms.txt)</span>
            <span class="item-meta">AI Spec</span>
          </a>
          <a
            href="/docs#react"
            class="search-result-item"
            data-text="react 18 19 nextjs next.js app router server components typescript wrappers"
          >
            <span>React 18 & 19 (Next.js 15 App Router)</span>
            <span class="item-meta">Framework</span>
          </a>
          <a
            href="/docs#svelte"
            class="search-result-item"
            data-text="svelte 5 runes state derived effect custom element"
          >
            <span>Svelte 5 (Runes Architecture)</span>
            <span class="item-meta">Framework</span>
          </a>
          <a
            href="/docs#vue"
            class="search-result-item"
            data-text="vue 3 nuxt 3 composition api custom element iscustomelement"
          >
            <span>Vue 3 & Nuxt 3 (Composition API)</span>
            <span class="item-meta">Framework</span>
          </a>
          <a
            href="/docs#htmx"
            class="search-result-item"
            data-text="htmx 2 backend ssr django rails laravel go templ partials"
          >
            <span>HTMX 2 & Backend SSR</span>
            <span class="item-meta">Framework</span>
          </a>
          <a
            href="/tokens"
            class="search-result-item"
            data-text="tokens themes dtcg palettes colors zinc slate violet emerald rose blue orange customizer radius"
          >
            <span>Design Tokens & Theme Studio</span>
            <span class="item-meta">Themes</span>
          </a>
          <a
            href="/typography"
            class="search-result-item"
            data-text="typography system font type scale heading text lead muted optical tracking monospace sans"
          >
            <span>Typography System & Scale</span>
            <span class="item-meta">Design System</span>
          </a>
          <a
            href="/docs#layout-primitives"
            class="search-result-item"
            data-text="layout primitives stack grid container separator flex layout zero js"
          >
            <span>Layout Primitives (Stack, Grid, Container)</span>
            <span class="item-meta">Primitives</span>
          </a>
          <a
            href="/docs#feedback-primitives"
            class="search-result-item"
            data-text="feedback status primitives spinner empty state loading indicator zero js"
          >
            <span>Feedback & Status Primitives (Spinner, Empty)</span>
            <span class="item-meta">Primitives</span>
          </a>
        </div>

        <!-- Group: All Components -->
        <div
          class="search-group"
          data-group="components"
          style="margin-top: 0.75rem;"
        >
          <div class="search-group-title">
            Components ({componentsList.length})
          </div>
          {
            componentsList.map((comp: any) => (
              <a
                href={`/components/${comp.slug}`}
                class="search-result-item"
                data-text={`${comp.slug} ${comp.name} ${comp.title} ${comp.description}`}
              >
                <span>{comp.title}</span>
                <span class="item-meta">
                  {comp.tier === 0
                    ? "Tier 0: Pure HTML"
                    : "Tier 2: Micro-Enhancer"}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="search-modal-footer">
        <div>
          Navigate <kbd class="search-kbd">↑</kbd>
          <kbd class="search-kbd">↓</kbd> · Select <kbd class="search-kbd"
            >↵</kbd>
        </div>
        <div>Close <kbd class="search-kbd">ESC</kbd></div>
      </div>
    </dialog>

    <!-- Page Content Slot -->
    <slot />

    <!-- Global Platform-Native Toaster (Mounted for all routes & previews) -->
    <ui-toaster position="bottom-right"></ui-toaster>

    <!-- Theme, Palette & Search Controller Script -->
    <script>
      import "nnuikit/client";
      import { toast } from "nnuikit";

      // Ensure global availability for inline scripts and interactive previews
      (window as any).toast = toast;

      function initDocsApp() {
        // --- 1. Theme & Palette Management ---
        const currentTheme =
          document.documentElement.getAttribute("data-theme") ||
          localStorage.getItem("nnui-theme") ||
          "dark";
        const currentPalette =
          document.documentElement.getAttribute("data-palette") ||
          localStorage.getItem("nnui-palette") ||
          "zinc";

        // Synchronize UI button icon and dropdown dot without triggering re-render
        syncThemeControls(currentTheme);
        syncPaletteControls(currentPalette);

        // Bind Theme Toggle Button
        const themeBtn = document.getElementById("theme-toggle");
        if (themeBtn) {
          themeBtn.addEventListener("click", () => {
            const current =
              document.documentElement.getAttribute("data-theme") || "dark";
            const next = current === "dark" ? "light" : "dark";

            // Only transition colors when user explicitly clicks the toggle
            document.documentElement.classList.add("theme-transition");
            applyThemeMode(next);
            localStorage.setItem("nnui-theme", next);

            setTimeout(() => {
              document.documentElement.classList.remove("theme-transition");
            }, 300);
          });
        }

        // Bind Palette Selector (<ui-dropdown>)
        const paletteDropdown = document.getElementById("palette-dropdown");
        if (paletteDropdown) {
          paletteDropdown.addEventListener("select", (e: any) => {
            const pal = e.detail?.value;
            if (pal) {
              applyPalette(pal);
              localStorage.setItem("nnui-palette", pal);
              window.dispatchEvent(
                new CustomEvent("nnui-palette-changed", {
                  detail: { palette: pal },
                }),
              );
            }
          });
        }

        // --- 2. Quick Search Command Modal (⌘K) ---
        const searchDialog = document.getElementById(
          "search-modal-dialog",
        ) as HTMLDialogElement | null;
        const searchTrigger = document.getElementById("search-trigger");
        const searchInput = document.getElementById(
          "search-modal-input",
        ) as HTMLInputElement | null;
        const searchClose = document.getElementById("search-modal-close");
        const resultsContainer = document.getElementById(
          "search-modal-results",
        );

        function openSearchModal() {
          if (!searchDialog) return;
          searchDialog.showModal();
          if (searchInput) {
            searchInput.value = "";
            searchInput.focus();
            filterSearchResults("");
          }
        }

        function closeSearchModal() {
          if (!searchDialog) return;
          searchDialog.close();
        }

        function filterSearchResults(query: string) {
          if (!resultsContainer) return;
          const q = query.toLowerCase().trim();
          const items = resultsContainer.querySelectorAll(
            ".search-result-item",
          ) as NodeListOf<HTMLElement>;
          let firstVisible: HTMLElement | null = null;

          items.forEach((item) => {
            const dataText = (
              item.getAttribute("data-text") || ""
            ).toLowerCase();
            const textContent = (item.textContent || "").toLowerCase();
            if (!q || dataText.includes(q) || textContent.includes(q)) {
              item.style.display = "flex";
              if (!firstVisible) firstVisible = item;
            } else {
              item.style.display = "none";
              item.classList.remove("selected");
            }
          });

          // Toggle visibility of group titles
          document.querySelectorAll(".search-group").forEach((group) => {
            const visibleInGroup = group.querySelectorAll(
              '.search-result-item:not([style*="display: none"])',
            );
            (group as HTMLElement).style.display =
              visibleInGroup.length > 0 ? "block" : "none";
          });

          // Highlight the first visible item
          items.forEach((i) => i.classList.remove("selected"));
          if (firstVisible) {
            (firstVisible as HTMLElement).classList.add("selected");
          }
        }

        if (searchTrigger) {
          searchTrigger.addEventListener("click", openSearchModal);
        }

        if (searchClose) {
          searchClose.addEventListener("click", closeSearchModal);
        }

        // Close when clicking outside modal backdrop
        if (searchDialog) {
          searchDialog.addEventListener("click", (e) => {
            const rect = searchDialog.getBoundingClientRect();
            const isInDialog =
              rect.top <= e.clientY &&
              e.clientY <= rect.top + rect.height &&
              rect.left <= e.clientX &&
              e.clientX <= rect.left + rect.width;
            if (!isInDialog) {
              closeSearchModal();
            }
          });
        }

        // Real-time Search Input filtering
        if (searchInput) {
          searchInput.addEventListener("input", (e) => {
            filterSearchResults((e.target as HTMLInputElement).value);
          });
        }

        // Keyboard Shortcut Navigation: ⌘K, Esc, Up/Down, Enter
        window.addEventListener("keydown", (e) => {
          // Open on ⌘K or Ctrl+K
          if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            if (searchDialog?.open) {
              closeSearchModal();
            } else {
              openSearchModal();
            }
            return;
          }

          // If search modal is open, handle arrows and Enter
          if (searchDialog?.open && resultsContainer) {
            const visibleItems = Array.from(
              resultsContainer.querySelectorAll(
                '.search-result-item:not([style*="display: none"])',
              ),
            ) as HTMLElement[];

            if (visibleItems.length === 0) return;

            let currentIndex = visibleItems.findIndex((item) =>
              item.classList.contains("selected"),
            );

            if (e.key === "ArrowDown") {
              e.preventDefault();
              const nextIndex =
                currentIndex < visibleItems.length - 1 ? currentIndex + 1 : 0;
              visibleItems.forEach((i) => i.classList.remove("selected"));
              visibleItems[nextIndex].classList.add("selected");
              visibleItems[nextIndex].scrollIntoView({ block: "nearest" });
            } else if (e.key === "ArrowUp") {
              e.preventDefault();
              const prevIndex =
                currentIndex > 0 ? currentIndex - 1 : visibleItems.length - 1;
              visibleItems.forEach((i) => i.classList.remove("selected"));
              visibleItems[prevIndex].classList.add("selected");
              visibleItems[prevIndex].scrollIntoView({ block: "nearest" });
            } else if (e.key === "Enter") {
              if (currentIndex >= 0 && visibleItems[currentIndex]) {
                e.preventDefault();
                visibleItems[currentIndex].click();
              }
            } else if (e.key === "Escape") {
              closeSearchModal();
            }
          }
        });
      }

      function syncThemeControls(theme: string) {
        const icon = document.getElementById("theme-icon");
        if (icon) {
          icon.textContent = theme === "dark" ? "☀️" : "🌙";
        }
      }

      function applyThemeMode(theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
        syncThemeControls(theme);
      }

      const PALETTE_DOT_COLORS: Record<string, string> = {
        zinc: "#71717a",
        slate: "#64748b",
        violet: "#8b5cf6",
        rose: "#f43f5e",
        emerald: "#10b981",
        blue: "#3b82f6",
        orange: "#f97316",
      };

      function syncPaletteControls(palette: string) {
        const dot = document.getElementById("active-palette-dot");
        const name = document.getElementById("active-palette-name");
        if (dot) {
          dot.style.background = PALETTE_DOT_COLORS[palette] || "#71717a";
        }
        if (name) {
          name.textContent = palette.charAt(0).toUpperCase() + palette.slice(1);
        }
      }

      function applyPalette(palette: string) {
        document.documentElement.setAttribute("data-palette", palette);
        syncPaletteControls(palette);
      }

      // --- 3. Universal Copy-to-Clipboard for Docs Code Blocks ---
      function initCodeCopyButtons() {
        document.querySelectorAll("pre").forEach((pre) => {
          if (pre.querySelector(".code-copy-btn")) return;
          if (pre.closest(".comp-preview-stage") || pre.closest(".comp-preview-viewport") || pre.closest("[data-ui]") || pre.closest("ui-ai-tool-call") || pre.closest("ui-ai-reasoning") || pre.closest("ui-ai-approval")) return;

          const parentBox = pre.closest(".code-block-box");
          const header = parentBox ? parentBox.querySelector(".code-block-header") : null;

          const copyBtn = document.createElement("button");
          copyBtn.className = "code-copy-btn";
          copyBtn.type = "button";
          copyBtn.title = "Copy code to clipboard";
          copyBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span>Copy</span>
          `;

          copyBtn.addEventListener("click", async (e) => {
            e.stopPropagation();
            const codeEl = pre.querySelector("code");
            const textToCopy = (codeEl ? codeEl.innerText : pre.innerText).trim();
            try {
              await navigator.clipboard.writeText(textToCopy);
              copyBtn.classList.add("copied");
              copyBtn.innerHTML = `
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Copied!</span>
              `;
              setTimeout(() => {
                copyBtn.classList.remove("copied");
                copyBtn.innerHTML = `
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span>Copy</span>
                `;
              }, 2000);
            } catch (err) {
              console.error("Failed to copy text: ", err);
            }
          });

          if (header) {
            header.appendChild(copyBtn);
          } else {
            pre.style.position = "relative";
            copyBtn.style.position = "absolute";
            copyBtn.style.top = "0.65rem";
            copyBtn.style.right = "0.65rem";
            pre.appendChild(copyBtn);
          }
        });
      }

      // Initialize on load and after DOM updates
      initDocsApp();
      initCodeCopyButtons();
      document.addEventListener("astro:page-load", () => {
        initDocsApp();
        initCodeCopyButtons();
      });
    </script>
  </body>
</html>

