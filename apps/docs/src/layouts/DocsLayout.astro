---
import "nnuikit/css";
import "../styles/docs.css";
import componentsData from "../data/components-data.json";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface ArticleMeta {
  datePublished?: string;
  dateModified?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  keywords?: string | string[];
  canonicalUrl?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  schema?: Record<string, any> | Array<Record<string, any>>;
  articleMeta?: ArticleMeta;
}

const {
  title = "NNUI-KIT — The All-In-One Universal UI Kit & Component Architecture",
  description = "NNUI-KIT is the all-in-one universal Light-DOM UI toolkit. 45+ accessible primitives and micro-enhancers with built-in state persistence, cross-tab sync, React 19 wrapper, and zero Shadow DOM traps.",
  activePath = "/",
  keywords,
  canonicalUrl,
  ogType = "website",
  ogImage = "/og-image.png",
  breadcrumbs,
  schema,
  articleMeta,
} = Astro.props;

const defaultSiteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://nnui-kit.vercel.app";
const currentCanonical =
  canonicalUrl ||
  `${defaultSiteUrl}${activePath.startsWith("/") ? activePath : `/${activePath}`}`;
const currentOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${defaultSiteUrl}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`
  : `${defaultSiteUrl}/og-image.png`;

const keywordsString = Array.isArray(keywords)
  ? keywords.join(", ")
  : keywords ||
    "all in one ui kit, all-in-one component library, universal ui kit, light dom web components, zero shadow dom, react 19 ui kit, vue 3 ui components, svelte 5 ui library, astro ui components, accessible design system, state persistence, cross tab sync, ai introspection protocol, nnui, nnuikit, modern web components, design tokens";

// Global WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "NNUI-KIT",
  alternateName: [
    "nnuikit",
    "NNUI",
    "New Age UI Kit",
    "All-In-One Universal UI Kit",
  ],
  url: defaultSiteUrl,
  description:
    "The All-In-One Universal Light-DOM UI Architecture. 45+ accessible primitives and micro-enhancers across React 19, Vue 3, Svelte 5, Astro, and HTML.",
  publisher: {
    "@type": "Organization",
    name: "NNUI-KIT",
    logo: {
      "@type": "ImageObject",
      url: `${defaultSiteUrl}/logo.png`,
    },
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${defaultSiteUrl}/components?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

// Global SoftwareApplication Schema
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "NNUI-KIT",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "All-in-One UI Component Library and Design System",
  operatingSystem:
    "Any (Web, React 18/19, Next.js, Vue 3, Nuxt, Svelte 5, SvelteKit, Astro, HTMX, Rails, SSR)",
  description:
    "All-in-one universal Light-DOM UI architecture with zero Shadow DOM accessibility traps, declarative state persistence, real-time cross-tab sync, and AI introspection protocol.",
  softwareVersion: "1.0.8",
  license: "https://opensource.org/licenses/MIT",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  url: defaultSiteUrl,
  downloadUrl: "https://www.npmjs.com/package/nnuikit",
  sameAs: [
    "https://github.com/harshp421/nnui-kit",
    "https://www.npmjs.com/package/nnuikit",
  ],
};

// Breadcrumbs Schema
const breadcrumbsSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          name: crumb.name,
          item: crumb.url.startsWith("http")
            ? crumb.url
            : `${defaultSiteUrl}${crumb.url}`,
        })),
      }
    : null;

// Aggregated schemas to render
const allSchemas = [
  websiteSchema,
  softwareAppSchema,
  ...(breadcrumbsSchema ? [breadcrumbsSchema] : []),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];

const componentsList = Object.values(componentsData) as any[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <!-- Primary Title & Standard SEO Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsString} />
    <meta name="author" content="NNUI-KIT Authors" />
    <meta name="creator" content="NNUI-KIT" />
    <meta name="publisher" content="NNUI-KIT" />
    <link rel="canonical" href={currentCanonical} />

    <!-- Crawlers & Search Engine Directives (SEO & AEO) -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="bingbot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Open Graph / Facebook / LinkedIn / Discord / Slack -->
    <meta
      property="og:site_name"
      content="NNUI-KIT — All-In-One Universal UI Kit"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:image" content={currentOgImage} />
    <meta property="og:image:secure_url" content={currentOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="NNUI-KIT — The All-In-One Universal UI Kit"
    />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nnuikit" />
    <meta name="twitter:creator" content="@nnuikit" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={currentOgImage} />
    <meta
      name="twitter:image:alt"
      content="NNUI-KIT — The All-In-One Universal UI Kit"
    />

    <!-- Mobile & Application Meta -->
    <meta name="application-name" content="NNUI-KIT" />
    <meta name="apple-mobile-web-app-title" content="NNUI-KIT" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="format-detection" content="telephone=no" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#09090b"
    />

    <!-- AI & Model Context Links (AEO) -->
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="AI Model Context (llms.txt)"
    />
    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap.xml"
    />

    <!-- JSON-LD Structured Data (Schema.org for Google Rich Results & AEO) -->
    {
      allSchemas.map((schemaObj) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schemaObj)}
        />
      ))
    }

    <!-- 0ms Synchronous Theme & Palette Hydration (Executes before paint to eliminate FOUC / flicker) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme =
            localStorage.getItem("nnui-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const savedPalette = localStorage.getItem("nnui-palette") || "zinc";
          const savedRadius = localStorage.getItem("nnui-radius") || "0.5";
          const root = document.documentElement;
          root.setAttribute("data-theme", savedTheme);
          root.setAttribute("data-palette", savedPalette);
          root.setAttribute("data-radius", savedRadius);
          if (savedTheme === "dark") {
            root.classList.add("dark");
          } else {
            root.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Top Sticky Frosted Glass Header -->
    <header class="docs-header">
      <div style="display: flex; align-items: center; gap: 2rem;">
        <a href="/" class="docs-logo">
          <img
            src="/logo.svg"
            alt="NNUI-KIT"
            class="docs-logo-img"
            width="24"
            height="24"
          />
          <span>nnui-kit</span>
          <span class="docs-version-pill">v1.0.8</span>
        </a>

        <nav class="docs-nav-links">
          <a
            href="/docs"
            class={`docs-nav-link ${activePath.startsWith("/docs") ? "active" : ""}`}
            >Docs</a
          >
          <a
            href="/components"
            class={`docs-nav-link ${activePath.startsWith("/components") ? "active" : ""}`}
            >Components</a
          >
          <a
            href="/tokens"
            class={`docs-nav-link ${activePath.startsWith("/tokens") ? "active" : ""}`}
            >Themes</a
          >
          <a
            href="/motion"
            class={`docs-nav-link ${activePath.startsWith("/motion") ? "active" : ""}`}
            style="display: inline-flex; align-items: center; gap: 0.35rem;"
          >
            <span>Motion</span>
            <span
              style="font-size: 0.65rem; background: color-mix(in srgb, var(--ui-color-brand-500, #8b5cf6) 15%, transparent); color: var(--ui-color-brand-500, #8b5cf6); padding: 1px 5px; border-radius: 9999px; font-weight: 700;"
              >SPRING</span
            >
          </a>
          <a
            href="/typography"
            class={`docs-nav-link ${activePath.startsWith("/typography") ? "active" : ""}`}
            >Typography</a
          >
          <a
            href="/shadow-vs-light"
            class={`docs-nav-link ${activePath.startsWith("/shadow-vs-light") ? "active" : ""}`}
            style="display: inline-flex; align-items: center; gap: 0.35rem;"
          >
            <span>Light vs Shadow</span>
            <span
              style="font-size: 0.65rem; background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); padding: 1px 5px; border-radius: 9999px; font-weight: 700;"
              >WHY</span
            >
          </a>
          <a
            href="/llms"
            class={`docs-nav-link ${activePath.startsWith("/llms") ? "active" : ""}`}
            style="display: inline-flex; align-items: center; gap: 0.35rem;"
          >
            <span>llms.txt</span>
            <span
              style="font-size: 0.65rem; background: color-mix(in srgb, var(--ui-color-brand-500) 15%, transparent); color: var(--ui-color-brand-500); border: 1px solid color-mix(in srgb, var(--ui-color-brand-500) 35%, transparent); padding: 1px 5px; border-radius: 9999px; font-weight: 700;"
              >AI</span
            >
          </a>
          <a
            href="https://github.com/harshp421/nnui-kit"
            target="_blank"
            rel="noopener noreferrer"
            class="docs-nav-link">GitHub ↗</a
          >
        </nav>
      </div>

      <div class="header-actions">
        <!-- Search Trigger (⌘K) -->
        <button
          class="search-trigger-btn"
          data-ui="button"
          data-variant="secondary"
          id="search-trigger"
          title="Quick Search (⌘K)"
        >
          <span>Search docs...</span>
          <kbd class="search-kbd">⌘K</kbd>
        </button>

        <!-- Brand Palette Selector (Dogfooding <ui-dropdown>) -->
        <ui-dropdown id="palette-dropdown" style="display: inline-block;">
          <button
            data-part="trigger"
            data-ui="button"
            data-variant="outline"
            class="palette-dropdown"
            style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; height: 32px; padding: 0.35rem 0.65rem;"
            title="Select color harmony palette"
          >
            <span
              id="active-palette-dot"
              style="width: 8px; height: 8px; border-radius: 50%; background: #71717a; display: inline-block; flex-shrink: 0;"
            ></span>
            <span
              id="active-palette-name"
              style="text-transform: capitalize; font-weight: 500; font-size: 0.8rem;"
              >Zinc</span
            >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="opacity: 0.6; margin-left: 2px;"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div
            data-part="menu"
            style="min-width: 145px; border-radius: 8px; padding: 0.25rem;"
          >
            <div data-part="item" data-value="zinc">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #71717a;"
                ></span>
                <span>Zinc</span>
              </div>
            </div>
            <div data-part="item" data-value="slate">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #64748b;"
                ></span>
                <span>Slate</span>
              </div>
            </div>
            <div data-part="item" data-value="violet">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #8b5cf6;"
                ></span>
                <span>Violet</span>
              </div>
            </div>
            <div data-part="item" data-value="rose">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #f43f5e;"
                ></span>
                <span>Rose</span>
              </div>
            </div>
            <div data-part="item" data-value="emerald">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"
                ></span>
                <span>Emerald</span>
              </div>
            </div>
            <div data-part="item" data-value="blue">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #3b82f6;"
                ></span>
                <span>Blue</span>
              </div>
            </div>
            <div data-part="item" data-value="orange">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span
                  style="width: 8px; height: 8px; border-radius: 50%; background: #f97316;"
                ></span>
                <span>Orange</span>
              </div>
            </div>
          </div>
        </ui-dropdown>

        <!-- Dark / Light Theme Mode Toggle Button -->
        <button
          id="theme-toggle"
          data-ui="button"
          data-variant="ghost"
          class="theme-toggle-btn"
          title="Toggle Theme (Light/Dark)"
        >
          <span id="theme-icon">☀️</span>
        </button>

        <!-- GitHub Stars Badge -->
        <a
          href="https://github.com/harshp421/nnui-kit"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
          data-ui="button"
          data-variant="secondary"
          style="padding: 0.35rem 0.75rem; font-size: 0.8rem; gap: 0.4rem;"
        >
          <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          <span>Star</span>
        </a>
      </div>
    </header>

    <!-- Quick Search Command Modal Dialog (⌘K) -->
    <dialog
      id="search-modal-dialog"
      data-ui="dialog"
      class="search-modal-dialog"
    >
      <div class="search-modal-header">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: var(--text-muted); flex-shrink: 0;"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="search-modal-input"
          type="search"
          data-ui="input"
          class="search-modal-input"
          placeholder="Search documentation, components, frameworks... (⌘K)"
          autocomplete="off"
        />
        <kbd
          class="search-kbd"
          id="search-modal-close"
          style="cursor: pointer;"
          title="Close dialog">ESC</kbd
