      <div style="max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;">
        <details data-ui="card" style="padding: 1.25rem 1.5rem; border-radius: 10px; border: 1px solid var(--border-subtle); background: var(--bg-card); cursor: pointer;" open>
