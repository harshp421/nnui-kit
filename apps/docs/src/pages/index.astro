---
import DocsLayout from '../layouts/DocsLayout.astro';
import registry from 'nnui-kit/registry.json';

const componentsList = Object.values(registry.components);

const htmlSnippet = `<!-- 100% Platform-Native Light-DOM Syntax (Zero React/Virtual DOM needed) -->
<ui-ai-prompt-box persist="local" placeholder="Ask AI assistant...">
  <textarea data-part="input"></textarea>
  <div data-part="toolbar">
    <button data-part="submit-btn" class="ui-button">Send</button>
  </div>
</ui-ai-prompt-box>

<ui-stepper current-step="2" linear persist="url" sync="cross-tab">
  <div data-part="step-list">
    <div data-part="step" data-step="1">Build</div>
    <div data-part="step" data-step="2">Deploy</div>
    <div data-part="step" data-step="3">Verify</div>
  </div>
</ui-stepper>

<ui-segmented-control value="admin">
  <button data-part="segment" data-value="viewer">Viewer</button>
  <button data-part="segment" data-value="admin">Admin</button>
  <button data-part="segment" data-value="owner">Owner</button>
</ui-segmented-control>`;

const reactSnippet = `// React 18 & 19 First-Class Wrapper (nnui-kit/react)
import 'nnui-kit/css';
import 'nnui-kit/client';
import { Stepper, SegmentedControl, AiPromptBox, toast } from 'nnui-kit/react';

export function Dashboard() {
  const [role, setRole] = useState('admin');

  return (
    <div className="space-y-4">
      <SegmentedControl value={role} onChange={(e) => setRole(e.detail.value)} />
      <AiPromptBox persist="local" onSubmit={(e) => toast.success('Prompt sent')} />
      <Stepper current-step={2} persist="url" sync="cross-tab" />
    </div>
  );
}`;

const svelteSnippet = `<!-- Svelte 5 (Runes) Integration -->
<script>
  import 'nnui-kit/css';
  import 'nnui-kit/client';
  let role = $state('admin');
</script>

<ui-segmented-control value={role} onchange={(e) => role = e.detail.value}>
  <button data-part="segment" data-value="viewer">Viewer</button>
  <button data-part="segment" data-value="admin">Admin</button>
  <button data-part="segment" data-value="owner">Owner</button>
</ui-segmented-control>`;

const vueSnippet = `<!-- Vue 3 (Composition API) -->
<script setup>
import { ref } from 'vue';
import 'nnui-kit/css';
import 'nnui-kit/client';

const role = ref('admin');
</script>

<template>
  <ui-segmented-control :value="role" @change="(e) => role = e.detail.value">
    <button data-part="segment" data-value="viewer">Viewer</button>
    <button data-part="segment" data-value="admin">Admin</button>
    <button data-part="segment" data-value="owner">Owner</button>
  </ui-segmented-control>
</template>`;
---

<DocsLayout title="NNUI-KIT — Platform-Native Light-DOM Component System" activePath="/">
  <div class="page-container">
    
    <!-- Hero Section (Atmospheric & High-Standard) -->
    <section class="hero-section" style="position: relative;">
      <div class="hero-ambient-glow"></div>

      <!-- Release Announcement Pill -->
      <a href="/docs" class="announcement-badge" data-ui="badge">
        <span class="badge-dot-pulsing"></span>
        <strong style="color: var(--text-main);">NNUI-KIT 1.0</strong>
        <span style="opacity: 0.4;">|</span>
        <span>Universal Light-DOM Component Architecture →</span>
      </a>

      <!-- Headline -->
      <h1 class="hero-headline">
        The UI Kit engineered for<br />
        <span style="background: linear-gradient(135deg, var(--text-main) 30%, var(--ui-color-brand-500, #3b82f6) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          the modern platform.
        </span>
      </h1>

      <p class="hero-description">
        45 accessible components & primitives living 100% in the Light DOM. First-class React 18/19 wrapper, Svelte 5, Vue 3, Astro, and HTMX 2 ready. Sub-40 KB runtime with native form participation.
      </p>

      <!-- Action Buttons & Interactive Terminal -->
      <div class="hero-actions">
        <a href="/components" class="btn-primary" data-ui="button" data-size="lg">
          Explore Components (45)
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.6498 10.6151 7.84212L6.86514 11.8421C6.67627 12.0436 6.35985 12.0538 6.1584 11.8649C5.95694 11.676 5.94673 11.3596 6.1356 11.1581L9.535 7.5L6.1356 3.84188C5.94673 3.64042 5.95694 3.32401 6.1584 3.13508Z" fill="currentColor"></path></svg>
        </a>

        <a href="/docs" class="btn-secondary" data-ui="button" data-variant="secondary" data-size="lg">
          Documentation & Guides
        </a>

        <!-- Interactive Package Manager Bar with <ui-segmented-control> -->
        <div class="pm-terminal-bar">
          <ui-segmented-control id="pm-segmented-control" value="npm">
            <button data-part="segment" data-value="npm">npm</button>
            <button data-part="segment" data-value="pnpm">pnpm</button>
            <button data-part="segment" data-value="bun">bun</button>
          </ui-segmented-control>
          <div class="pm-command-display">
            <span style="color: var(--text-muted);">$</span>
            <code id="pm-command-text" style="color: var(--text-main); font-weight: 600;">npx nnui init</code>
          </div>
          <button id="pm-copy-trigger" data-ui="button" data-variant="secondary" data-size="xs" class="pm-copy-btn" title="Copy CLI command">
            <span id="pm-copy-label">copy</span>
          </button>
        </div>
      </div>

      <!-- Tech Stack Badges (Using NNUI-KIT Badge System) -->
      <div class="tech-pill-list">
        <span class="tech-pill" data-ui="badge" data-variant="secondary">⚛️ React 18 & 19</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">⚡ Next.js 15</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">🔥 Svelte 5</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">💚 Vue 3</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">🚀 Astro</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">🌐 HTMX 2</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">🛡️ Zero Shadow DOM</span>
        <span class="tech-pill" data-ui="badge" data-variant="secondary">🎨 DTCG Tokens</span>
      </div>
    </section>

    <!-- Metrics Section (Engineering Excellence) -->
    <section class="metrics-section">
      <div class="metrics-grid">
        <div>
          <div class="metric-num">38.9 kB</div>
          <div class="metric-label">Complete Suite (Gzipped JS)</div>
        </div>
        <div>
          <div class="metric-num">Zero</div>
          <div class="metric-label">Shadow DOM Barriers</div>
        </div>
        <div>
          <div class="metric-num">15,000+</div>
          <div class="metric-label">Rows Virtualized at 60 FPS</div>
        </div>
        <div>
          <div class="metric-num">100%</div>
          <div class="metric-label">WAI-ARIA APG Accessible</div>
        </div>
      </div>
    </section>

    <!-- Interactive Component Playground Stage (macOS Frame + <ui-tabs>) -->
    <div class="showcase-wrapper" style="box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.3);">
      <ui-tabs id="showcase-ui-tabs" value="preview">
        <!-- Window Chrome Header -->
        <div class="showcase-header">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <!-- Traffic Light Window Dots -->
            <div class="window-dots">
              <span class="window-dot window-dot-red"></span>
              <span class="window-dot window-dot-yellow"></span>
              <span class="window-dot window-dot-green"></span>
            </div>

            <!-- Tabs Bar -->
            <div data-part="tablist" class="showcase-tabs">
              <button data-part="tab" data-value="preview" class="showcase-tab active">Interactive Studio</button>
              <button data-part="tab" data-value="html" class="showcase-tab">HTML / Web Component</button>
              <button data-part="tab" data-value="react" class="showcase-tab">React 19 (JSX)</button>
              <button data-part="tab" data-value="svelte" class="showcase-tab">Svelte 5</button>
              <button data-part="tab" data-value="vue" class="showcase-tab">Vue 3</button>
            </div>
          </div>

          <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
            <span style="font-family: var(--docs-font-mono);">nnui-studio.tsx</span>
          </div>
        </div>

        <!-- Live Stage Canvas -->
        <div data-part="tabpanel" data-value="preview" id="tab-canvas-preview" class="showcase-canvas">
          <div class="showcase-grid">
            
            <!-- Widget 1: AI Prompt Studio (<ui-ai-prompt-box>) -->
            <div class="showcase-widget" data-ui="card">
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.85rem;">
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.1rem;">🤖</span>
                    <strong style="font-size: 0.95rem; color: var(--text-main);">AI Prompt Studio</strong>
                  </div>
                  <span data-ui="badge" data-variant="subtle" style="font-size: 0.7rem;">
                    persist="local"
                  </span>
                </div>

                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem; line-height: 1.4;">
                  Declarative draft auto-saving via Light-DOM state sync. Try typing or selecting a preset:
                </p>

                <!-- Live AI Prompt Box -->
                <ui-ai-prompt-box id="landing-prompt-box" max-rows="3" persist="local" placeholder="Ask AI coding assistant (draft autosaves)..." style="width: 100%; margin-bottom: 0.75rem;">
                  <textarea data-part="input"></textarea>
                  <div data-part="toolbar">
                    <div style="display: flex; gap: 0.35rem;">
                      <button data-part="attach-btn" type="button" class="ui-button ui-button--ghost" style="padding: 0.3rem 0.5rem; font-size: 0.85rem;" title="Attach file">📎</button>
                      <button type="button" class="ui-button ui-button--ghost" style="padding: 0.3rem 0.5rem; font-size: 0.85rem;" title="Microphone">🎙️</button>
                    </div>
                    <div style="display: flex; gap: 0.35rem;">
                      <button data-part="submit-btn" type="button" class="ui-button" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">Send ▲</button>
                    </div>
                  </div>
                </ui-ai-prompt-box>

                <!-- Quick Prompt Suggestions -->
                <div class="prompt-chips-row">
                  <span style="font-size: 0.7rem; color: var(--text-muted); display: flex; align-items: center;">Try:</span>
                  <button type="button" class="prompt-chip" data-prompt="Build an accessible 3-step deployment wizard">Wizard Flow</button>
                  <button type="button" class="prompt-chip" data-prompt="Add 2FA OTP verification modal">2FA Modal</button>
                  <button type="button" class="prompt-chip" data-prompt="Render 15,000 virtual rows at 60 FPS">Virtual Grid</button>
                </div>

                <!-- Submitted Prompt Display Card -->
                <div style="padding: 0.65rem 0.85rem; background: var(--bg-secondary); border: 1px solid var(--border-subtle); border-radius: 8px; font-size: 0.78rem; color: var(--text-muted);">
                  <span style="font-weight: 600;">Active State: </span>
                  <code id="landing-prompt-output" style="color: var(--ui-color-brand-500); font-weight: 600;">(ready for prompt)</code>
                </div>
              </div>

              <!-- Action Footer (Equal alignment with Widget 2) -->
              <div style="display: flex; gap: 0.75rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
                <button id="ai-clear-btn" data-ui="button" data-variant="secondary" class="btn-secondary" style="flex: 1; font-size: 0.8rem; padding: 0.45rem;">
                  Clear Draft
                </button>
                <button id="ai-run-btn" data-ui="button" class="btn-primary" style="flex: 1; font-size: 0.8rem; padding: 0.45rem;">
                  Run Prompt ⚡
                </button>
              </div>
            </div>

            <!-- Widget 2: Interactive Pipeline & Security (<ui-stepper>, <ui-segmented-control>, <ui-otp-input>) -->
            <div class="showcase-widget" data-ui="card">
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.85rem;">
                  <strong style="font-size: 0.95rem; color: var(--text-main);">Pipeline & Controls</strong>
                  <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem; border-color: #10b981; color: #10b981;">
                    Live Sync
                  </span>
                </div>

                <!-- Interactive Live Stepper with Click Controls -->
                <div style="margin-bottom: 1rem;">
                  <ui-stepper id="landing-stepper" current-step="2" linear style="margin-bottom: 0.5rem;">
                    <div data-part="step-list" style="display: flex; gap: 0.5rem; justify-content: space-between;">
                      <div data-part="step" data-step="1" style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                        <span id="step-badge-1" style="width: 20px; height: 20px; border-radius: 50%; background: #10b981; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.65rem;">✓</span>
                        <span style="font-size: 0.8rem; font-weight: 600;">Build</span>
                      </div>
                      <div data-part="step" data-step="2" style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                        <span id="step-badge-2" style="width: 20px; height: 20px; border-radius: 50%; background: var(--text-main); color: var(--bg-primary); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700;">2</span>
                        <span style="font-size: 0.8rem; font-weight: 600;">Deploy</span>
                      </div>
                      <div data-part="step" data-step="3" style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                        <span id="step-badge-3" style="width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--border-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 0.65rem;">3</span>
                        <span style="font-size: 0.8rem; color: var(--text-muted);">Verify</span>
                      </div>
                    </div>
                  </ui-stepper>

                  <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                    <button id="stepper-prev-btn" data-ui="button" data-variant="secondary" data-size="xs">← Prev Step</button>
                    <button id="stepper-next-btn" data-ui="button" data-variant="secondary" data-size="xs">Next Step →</button>
                  </div>
                </div>

                <!-- Segmented Control Role Selector -->
                <div style="margin-bottom: 1rem;">
                  <label style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 0.35rem;">Access Role</label>
                  <ui-segmented-control id="landing-segmented" value="admin" style="width: 100%;">
                    <button data-part="segment" data-value="viewer" style="flex: 1;">Viewer</button>
                    <button data-part="segment" data-value="admin" style="flex: 1;">Admin</button>
                    <button data-part="segment" data-value="owner" style="flex: 1;">Owner</button>
                  </ui-segmented-control>
                </div>

                <!-- OTP Code & Multi-Tab Sync Switch -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: center; padding-top: 0.5rem;">
                  <div>
                    <label style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 0.35rem;">2FA Security</label>
                    <ui-otp-input length="4"></ui-otp-input>
                  </div>

                  <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">Cross-Tab Sync</span>
                    <label data-ui="switch" style="cursor: pointer;">
                      <input type="checkbox" checked />
                      <span data-part="slider"></span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Action Footer (Equal alignment with Widget 1) -->
              <div style="display: flex; gap: 0.75rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
                <button data-dialog-target="demo-dialog" data-ui="button" data-variant="secondary" class="btn-secondary" style="flex: 1; font-size: 0.8rem; padding: 0.45rem;">
                  Open Modal
                </button>
                <button id="toast-demo-action" data-ui="button" class="btn-primary" style="flex: 1; font-size: 0.8rem; padding: 0.45rem;">
                  Trigger Toast
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- Code Panes -->
        <div data-part="tabpanel" data-value="html" id="tab-canvas-html" style="display: none;">
          <pre class="code-viewer-pre"><code>{htmlSnippet}</code></pre>
        </div>

        <div data-part="tabpanel" data-value="react" id="tab-canvas-react" style="display: none;">
          <pre class="code-viewer-pre"><code>{reactSnippet}</code></pre>
        </div>

        <div data-part="tabpanel" data-value="svelte" id="tab-canvas-svelte" style="display: none;">
          <pre class="code-viewer-pre"><code>{svelteSnippet}</code></pre>
        </div>

        <div data-part="tabpanel" data-value="vue" id="tab-canvas-vue" style="display: none;">
          <pre class="code-viewer-pre"><code>{vueSnippet}</code></pre>
        </div>
      </ui-tabs>
    </div>

    <!-- Live Native Dialog (Hidden until triggered) -->
    <ui-dialog id="demo-dialog">
      <dialog data-part="dialog" data-ui="dialog" style="border: 1px solid var(--border-subtle); border-radius: 12px; padding: 2rem; max-width: 480px; width: 90%; background: var(--bg-card); color: var(--text-main); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);">
        <div data-part="dialog-header" style="margin-bottom: 1rem;">
          <h3 data-part="dialog-title" style="margin-top: 0; font-size: 1.25rem; font-weight: 700;">Platform-Native &lt;ui-dialog&gt;</h3>
          <p data-part="dialog-description" style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">
            Executes directly via HTML5 &lt;dialog&gt; top-layer specification with built-in keyboard focus trap, Esc-key dismiss, and Light-DOM accessibility integration.
          </p>
        </div>
        <div data-part="dialog-footer" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
          <button data-part="close" data-ui="button" data-variant="secondary" class="btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">Cancel</button>
          <button data-part="close" data-ui="button" class="btn-primary" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">Save Changes</button>
        </div>
      </dialog>
    </ui-dialog>

    <ui-toaster position="bottom-right"></ui-toaster>

    <!-- Component Wall Marquee (Animated Carousel of All 45 Components) -->
    <div style="margin: 5rem 0 2rem; text-align: center;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">
          Complete Production Suite (45 Components)
        </h3>
        <span data-ui="badge" data-variant="secondary" style="font-size: 0.75rem;">Sub-40 kB</span>
      </div>

      <div class="component-marquee-container">
        <div class="component-marquee-track">
          {componentsList.concat(componentsList).map((comp: any) => (
            <a href={`/components/${comp.name}`} class="marquee-chip" data-ui="card">
              <span style="color: var(--ui-color-brand-500); font-size: 0.8rem;">◆</span>
              <span>{comp.title}</span>
              <span class="docs-version-pill" data-ui="badge" style="font-size: 0.65rem;">
                {comp.tier === 0 ? 'Zero-JS' : 'Light-DOM'}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Crown Innovations Bento Grid (6 Architectural Pillars) -->
    <section style="margin-bottom: 5rem;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.75rem; color: var(--text-main);">
          Engineered for the Open Web.
        </h2>
        <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 650px; margin: 0 auto; line-height: 1.6;">
          Everything you love about modern UI components (Tailwind, keyboard accessibility, state hydration) without virtual DOM overhead or framework lock-in.
        </p>
      </div>

      <div class="bento-grid">
        <!-- 1. Zero Shadow DOM -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">🛡️</div>
          <h3>Zero Shadow DOM Traps</h3>
          <p>Lives 100% in the document Light DOM. Forms serialize natively via <code>ElementInternals</code>, global Tailwind and CSS variables apply directly, and assistive technologies see unbroken DOM trees.</p>
        </div>

        <!-- 2. Sub-40 KB Complete Suite -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">⚡</div>
          <h3>Sub-40 KB Complete Suite</h3>
          <p>All 45 components + virtualized data grid + calendar bundle into only <strong>38.9 kB gzipped JavaScript</strong> — running 5x lighter than MUI, Mantine, or Radix + AG Grid.</p>
        </div>

        <!-- 3. Declarative State & URL Sync -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">🌐</div>
          <h3>Declarative State & URL Sync</h3>
          <p>Add <code>persist="url"</code> to synchronize sorting and search queries directly to URL parameters, and <code>persist="local"</code> to autosave drafts without router boilerplate.</p>
        </div>

        <!-- 4. Real-Time Cross-Tab Sync -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">📡</div>
          <h3>Real-Time Cross-Tab Sync</h3>
          <p>Add <code>sync="cross-tab"</code> to synchronize state across multiple open tabs and windows via the native browser <code>BroadcastChannel</code> with <strong>zero server or WebSocket setup</strong>.</p>
        </div>

        <!-- 5. AI Machine-Readable Protocol -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">🤖</div>
          <h3>AI Introspection Protocol</h3>
          <p>Call <code>element.inspectAI()</code> to retrieve machine-readable JSON schemas, active state, and copy-ready framework snippets tailored for autonomous coding agents (Claude, Cursor, Copilot).</p>
        </div>

        <!-- 6. W3C DTCG Multi-Palette System -->
        <div class="bento-card" data-ui="card">
          <div class="bento-icon">🎨</div>
          <h3>W3C DTCG Token System</h3>
          <p>Engineered with 11-step tonal harmony scales (Zinc, Slate, Violet, Rose, Emerald, Blue, Orange) conforming to the W3C Design Tokens Community Group specification.</p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Card -->
    <section style="margin-bottom: 5rem; text-align: center;">
      <div data-ui="card" style="padding: 3.5rem 2rem; border-radius: 16px; background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-secondary) 100%); border: 1px solid var(--border-subtle); max-width: 800px; margin: 0 auto; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);">
        <h2 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; margin: 0 0 1rem; color: var(--text-main);">
          Ready to build platform-native interfaces?
        </h2>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin: 0 0 2rem; line-height: 1.6;">
          Install any component in seconds via CLI or import as universal web components.
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/components" data-ui="button" data-size="lg" class="btn-primary">
            Explore 45 Components →
          </a>
          <a href="https://github.com/harshp421/nnui-kit" target="_blank" rel="noopener noreferrer" data-ui="button" data-variant="secondary" data-size="lg" class="btn-secondary">
            GitHub Repository
          </a>
        </div>
      </div>
    </section>

  </div>
</DocsLayout>

<script>
  import { toast } from 'nnui-kit';

  // 1. Package Manager Switcher with <ui-segmented-control>
  const pmControl = document.getElementById('pm-segmented-control');
  const pmCmdText = document.getElementById('pm-command-text');
  const pmCopyBtn = document.getElementById('pm-copy-trigger');
  const pmCopyLabel = document.getElementById('pm-copy-label');

  const pmCommands: Record<string, string> = {
    npm: 'npx nnui init',
    pnpm: 'pnpm dlx nnui init',
    bun: 'bunx nnui init',
  };

  let activePm = 'npm';

  if (pmControl) {
    pmControl.addEventListener('change', (e: any) => {
      activePm = e.detail?.value || 'npm';
      if (pmCmdText) pmCmdText.textContent = pmCommands[activePm] || 'npx nnui init';
    });
  }

  if (pmCopyBtn && pmCopyLabel) {
    pmCopyBtn.addEventListener('click', async () => {
      const cmd = pmCommands[activePm] || 'npx nnui init';
      await navigator.clipboard.writeText(cmd);
      pmCopyLabel.textContent = '✓ copied!';
      setTimeout(() => {
        pmCopyLabel.textContent = 'copy';
      }, 2000);
    });
  }

  // 2. Interactive AI Prompt Box Demo & Quick Suggestions
  const promptBox = document.getElementById('landing-prompt-box') as any;
  const promptOutput = document.getElementById('landing-prompt-output');
  const promptChips = document.querySelectorAll('.prompt-chip');
  const aiClearBtn = document.getElementById('ai-clear-btn');
  const aiRunBtn = document.getElementById('ai-run-btn');

  function handlePromptSubmit(val: string) {
    if (val && promptOutput) {
      promptOutput.textContent = `"${val}"`;
      toast({
        title: 'Prompt Processed',
        description: `Dispatched: "${val.slice(0, 32)}..."`,
        type: 'success'
      });
    }
  }

  if (promptBox && promptOutput) {
    promptBox.addEventListener('submit', (e: any) => {
      const val = e.detail?.prompt || (promptBox.querySelector('textarea') as HTMLTextAreaElement)?.value;
      handlePromptSubmit(val);
    });
  }

  promptChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const text = chip.getAttribute('data-prompt') || '';
      if (promptBox) {
        const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
        if (textarea) {
          textarea.value = text;
          textarea.focus();
        }
      }
    });
  });

  if (aiClearBtn && promptBox) {
    aiClearBtn.addEventListener('click', () => {
      const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
      if (textarea) textarea.value = '';
      if (promptOutput) promptOutput.textContent = '(draft cleared)';
    });
  }

  if (aiRunBtn && promptBox) {
    aiRunBtn.addEventListener('click', () => {
      const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
      const val = textarea?.value || 'Build an accessible 3-step deployment wizard';
      handlePromptSubmit(val);
    });
  }

  // 3. Interactive Stepper Demo (Prev / Next Buttons)
  const stepper = document.getElementById('landing-stepper') as any;
  const prevBtn = document.getElementById('stepper-prev-btn');
  const nextBtn = document.getElementById('stepper-next-btn');

  function updateStepperVisuals(step: number) {
    const badges = [
      document.getElementById('step-badge-1'),
      document.getElementById('step-badge-2'),
      document.getElementById('step-badge-3')
    ];
    badges.forEach((b, idx) => {
      if (!b) return;
      const s = idx + 1;
      if (s < step) {
        b.textContent = '✓';
        b.style.background = '#10b981';
        b.style.color = '#fff';
      } else if (s === step) {
        b.textContent = String(s);
        b.style.background = 'var(--text-main)';
        b.style.color = 'var(--bg-primary)';
      } else {
        b.textContent = String(s);
        b.style.background = 'transparent';
        b.style.border = '1px solid var(--border-subtle)';
        b.style.color = 'var(--text-muted)';
      }
    });
  }

  let currentStep = 2;
  if (prevBtn && stepper) {
    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        stepper.setAttribute('current-step', String(currentStep));
        updateStepperVisuals(currentStep);
      }
    });
  }

  if (nextBtn && stepper) {
    nextBtn.addEventListener('click', () => {
      if (currentStep < 3) {
        currentStep++;
        stepper.setAttribute('current-step', String(currentStep));
        updateStepperVisuals(currentStep);
      }
    });
  }

  // 4. Toast Notification Action
  const toastBtn = document.getElementById('toast-demo-action');
  if (toastBtn) {
    toastBtn.addEventListener('click', () => {
      toast({
        title: 'Deployment Initiated',
        description: 'Universal Light-DOM sync active across 45 components.',
        type: 'success'
      });
    });
  }

  // 5. Showcase Tabs Synchronization
  const showcaseTabs = document.getElementById('showcase-ui-tabs');
  const tabButtons = showcaseTabs?.querySelectorAll('[data-part="tab"]');
  const tabPanels = {
    preview: document.getElementById('tab-canvas-preview'),
    html: document.getElementById('tab-canvas-html'),
    react: document.getElementById('tab-canvas-react'),
    svelte: document.getElementById('tab-canvas-svelte'),
    vue: document.getElementById('tab-canvas-vue'),
  };

  tabButtons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-value') || 'preview';
      Object.entries(tabPanels).forEach(([key, panel]) => {
        if (panel) {
          panel.style.display = key === val ? (key === 'preview' ? 'flex' : 'block') : 'none';
        }
      });
    });
  });
</script>
