<script>
  import { toast } from 'nnui-kit';

  // 1. Package Manager Switcher with <ui-segmented-control>
  const pmControl = document.getElementById('pm-segmented-control');
  const pmCmdText = document.getElementById('pm-command-text');
  const pmCopyBtn = document.getElementById('pm-copy-trigger');
  const pmCopyLabel = document.getElementById('pm-copy-label');

  const pmCommands: Record<string, string> = {
    npm: 'npx nnui init',
    pnpm: 'pnpm dlx nnui init',
    bun: 'bunx nnui init',
  };

  let activePm = 'npm';

  if (pmControl) {
    pmControl.addEventListener('change', (e: any) => {
      activePm = e.detail?.value || 'npm';
      if (pmCmdText) pmCmdText.textContent = pmCommands[activePm] || 'npx nnui init';
    });
  }

  if (pmCopyBtn && pmCopyLabel) {
    pmCopyBtn.addEventListener('click', async () => {
      const cmd = pmCommands[activePm] || 'npx nnui init';
      await navigator.clipboard.writeText(cmd);
      pmCopyLabel.textContent = '✓ copied!';
      setTimeout(() => {
        pmCopyLabel.textContent = 'copy';
      }, 2000);
    });
  }

  // 2. Interactive AI Prompt Box Demo & Quick Suggestions
  const promptBox = document.getElementById('landing-prompt-box') as any;
  const promptOutput = document.getElementById('landing-prompt-output');
  const promptChips = document.querySelectorAll('.prompt-chip');
  const aiClearBtn = document.getElementById('ai-clear-btn');
  const aiRunBtn = document.getElementById('ai-run-btn');

  function handlePromptSubmit(val: string) {
    if (val && promptOutput) {
      promptOutput.textContent = `"${val}"`;
      toast({
        title: 'Prompt Processed',
        description: `Dispatched: "${val.slice(0, 32)}..."`,
        type: 'success'
      });
    }
  }

  if (promptBox && promptOutput) {
    promptBox.addEventListener('submit', (e: any) => {
      const val = e.detail?.prompt || (promptBox.querySelector('textarea') as HTMLTextAreaElement)?.value;
      handlePromptSubmit(val);
    });
  }

  promptChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const text = chip.getAttribute('data-prompt') || '';
      if (promptBox) {
        const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
        if (textarea) {
          textarea.value = text;
          textarea.focus();
        }
      }
    });
  });

  if (aiClearBtn && promptBox) {
    aiClearBtn.addEventListener('click', () => {
      const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
      if (textarea) textarea.value = '';
      if (promptOutput) promptOutput.textContent = '(draft cleared)';
    });
  }

  if (aiRunBtn && promptBox) {
    aiRunBtn.addEventListener('click', () => {
      const textarea = promptBox.querySelector('textarea') as HTMLTextAreaElement;
      const val = textarea?.value || 'Build an accessible 3-step deployment wizard';
      handlePromptSubmit(val);
    });
  }

  // 3. Interactive Stepper Demo (Prev / Next Buttons)
  const stepper = document.getElementById('landing-stepper') as any;
  const prevBtn = document.getElementById('stepper-prev-btn');
  const nextBtn = document.getElementById('stepper-next-btn');

  function updateStepperVisuals(step: number) {
    const badges = [
      document.getElementById('step-badge-1'),
      document.getElementById('step-badge-2'),
      document.getElementById('step-badge-3')
    ];
    badges.forEach((b, idx) => {
      if (!b) return;
      const s = idx + 1;
      if (s < step) {
        b.textContent = '✓';
        b.style.background = 'var(--ui-color-brand-600)';
        b.style.color = '#fff';
        b.style.boxShadow = 'none';
        b.style.border = 'none';
      } else if (s === step) {
        b.textContent = String(s);
        b.style.background = 'var(--ui-color-brand-600)';
        b.style.color = '#fff';
        b.style.boxShadow = '0 0 0 3px var(--ui-focus-ring)';
        b.style.border = 'none';
      } else {
        b.textContent = String(s);
        b.style.background = 'transparent';
        b.style.border = '1px solid var(--border-subtle)';
        b.style.color = 'var(--text-muted)';
        b.style.boxShadow = 'none';
      }
    });
  }

  let currentStep = 2;
  if (prevBtn && stepper) {
    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        stepper.setAttribute('current-step', String(currentStep));
        updateStepperVisuals(currentStep);
      }
    });
  }

  if (nextBtn && stepper) {
    nextBtn.addEventListener('click', () => {
      if (currentStep < 3) {
        currentStep++;
        stepper.setAttribute('current-step', String(currentStep));
        updateStepperVisuals(currentStep);
      }
    });
  }

  // 4. Toast Notification Action
  const toastBtn = document.getElementById('toast-demo-action');
  if (toastBtn) {
    toastBtn.addEventListener('click', () => {
      toast.success('Pipeline Deployed', {
        description: 'Universal Light-DOM sync active across 45 components.',
        action: {
          label: 'View Logs',
          onClick: () => {
            toast.info('Connecting to logs...', { description: 'Build run #402 streaming in real-time' });
          }
        }
      });
    });
  }

  // 5. Showcase Tabs Synchronization
  const showcaseTabs = document.getElementById('showcase-ui-tabs');
  const tabButtons = showcaseTabs?.querySelectorAll('[data-part="tab"]');
  const tabPanels = {
    preview: document.getElementById('tab-canvas-preview'),
    html: document.getElementById('tab-canvas-html'),
    react: document.getElementById('tab-canvas-react'),
    svelte: document.getElementById('tab-canvas-svelte'),
    vue: document.getElementById('tab-canvas-vue'),
  };

  tabButtons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-value') || 'preview';
      Object.entries(tabPanels).forEach(([key, panel]) => {
        if (panel) {
          panel.style.display = key === val ? (key === 'preview' ? 'flex' : 'block') : 'none';
        }
      });
    });
  });
</script>
