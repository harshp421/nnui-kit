---
import DocsLayout from '../../layouts/DocsLayout.astro';
import tokens from 'nnui-kit/tokens.json';

const palettes = [
  { name: 'zinc', hex: '#71717a', label: 'Zinc (Neutral)' },
  { name: 'slate', hex: '#64748b', label: 'Slate (Cool)' },
  { name: 'violet', hex: '#8b5cf6', label: 'Violet (Electric)' },
  { name: 'blue', hex: '#3b82f6', label: 'Blue (Corporate)' },
  { name: 'emerald', hex: '#10b981', label: 'Emerald (Forest)' },
  { name: 'rose', hex: '#f43f5e', label: 'Rose (Vibrant)' },
  { name: 'orange', hex: '#f97316', label: 'Orange (Warm)' },
];

const radii = [
  { val: '0', label: '0px' },
  { val: '0.3', label: '0.3rem' },
  { val: '0.5', label: '0.5rem' },
  { val: '0.75', label: '0.75rem' },
  { val: '1.0', label: '1.0rem' },
  { val: 'full', label: 'Full' },
];

const colorShades = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

const tokenDictionary = [
  { category: 'surface', name: '--ui-bg-canvas', light: '#ffffff', dark: '#09090b', desc: 'Main document canvas & background', type: 'color' },
  { category: 'surface', name: '--ui-bg-surface', light: '#ffffff', dark: '#09090b', desc: 'Card, dialog, and panel surface container', type: 'color' },
  { category: 'surface', name: '--ui-bg-surface-elevated', light: '#f4f4f5', dark: '#18181b', desc: 'Floating popovers, dropdowns, and elevated cards', type: 'color' },
  { category: 'surface', name: '--ui-bg-subtle', light: '#f4f4f5', dark: '#27272a', desc: 'Secondary backgrounds, pill buttons, alternate rows', type: 'color' },
  { category: 'surface', name: '--ui-bg-hover', light: '#e4e4e7', dark: '#27272a', desc: 'Interactive item hover state', type: 'color' },
  { category: 'surface', name: '--ui-bg-active', light: '#d4d4d8', dark: '#3f3f46', desc: 'Active/pressed button or item state', type: 'color' },
  { category: 'surface', name: '--ui-bg', light: 'var(--ui-bg-canvas)', dark: 'var(--ui-bg-canvas)', desc: 'Canonical convenience shortcut alias for canvas', type: 'alias' },

  { category: 'text', name: '--ui-text-primary', light: '#09090b', dark: '#fafafa', desc: 'Headings and high-contrast body copy', type: 'color' },
  { category: 'text', name: '--ui-text-secondary', light: '#52525b', dark: '#a1a1aa', desc: 'Subheadings, field labels, and secondary copy', type: 'color' },
  { category: 'text', name: '--ui-text-muted', light: '#71717a', dark: '#71717a', desc: 'Placeholders, helper captions, and subtle timestamps', type: 'color' },
  { category: 'text', name: '--ui-text-inverted', light: '#fafafa', dark: '#09090b', desc: 'Inverted text for dark tooltips or solid badges', type: 'color' },
  { category: 'text', name: '--ui-text', light: 'var(--ui-text-primary)', dark: 'var(--ui-text-primary)', desc: 'Canonical convenience shortcut alias for primary text', type: 'alias' },

  { category: 'border', name: '--ui-border-subtle', light: '#f4f4f5', dark: '#18181b', desc: 'Gentle dividers and subtle card section borders', type: 'color' },
  { category: 'border', name: '--ui-border-default', light: '#e4e4e7', dark: '#27272a', desc: 'Standard border for buttons, inputs, cards, and tables', type: 'color' },
  { category: 'border', name: '--ui-border-strong', light: '#d4d4d8', dark: '#3f3f46', desc: 'Emphasized borders and active segmented tabs', type: 'color' },
  { category: 'border', name: '--ui-border-focus', light: '#09090b', dark: '#fafafa', desc: 'High-visibility accessible keyboard focus ring', type: 'color' },
  { category: 'border', name: '--ui-border', light: 'var(--ui-border-default)', dark: 'var(--ui-border-default)', desc: 'Canonical convenience shortcut alias for default border', type: 'alias' },

  { category: 'brand', name: '--ui-color-brand-500', light: '#71717a', dark: '#71717a', desc: 'Primary brand accent for buttons, switches, and sliders', type: 'color' },
  { category: 'brand', name: '--ui-color-accent-400', light: '#38bdf8', dark: '#38bdf8', desc: 'Secondary brand accent highlight', type: 'color' },
  { category: 'brand', name: '--ui-color-accent-500', light: '#0ea5e9', dark: '#0ea5e9', desc: 'Interactive primary brand accent', type: 'color' },

  { category: 'status', name: '--ui-color-success-500', light: '#10b981', dark: '#10b981', desc: 'Success notifications, verified tags, and active status', type: 'color' },
  { category: 'status', name: '--ui-color-warning-500', light: '#f59e0b', dark: '#f59e0b', desc: 'Warning callouts, pending badges, and caution states', type: 'color' },
  { category: 'status', name: '--ui-color-danger-500', light: '#ef4444', dark: '#ef4444', desc: 'Destructive buttons, error alerts, and validation errors', type: 'color' },

  { category: 'typography', name: '--ui-font-sans', light: 'Inter, system-ui, sans-serif', dark: 'Inter, system-ui, sans-serif', desc: 'Primary application UI font stack', type: 'font' },
  { category: 'typography', name: '--ui-font-mono', light: 'JetBrains Mono, monospace', dark: 'JetBrains Mono, monospace', desc: 'Monospace font stack for code and IDs', type: 'font' },
  { category: 'typography', name: '--ui-font-size-xs', light: '0.75rem (12px)', dark: '0.75rem (12px)', desc: 'Extra small captions and badge labels', type: 'size' },
  { category: 'typography', name: '--ui-font-size-sm', light: '0.875rem (14px)', dark: '0.875rem (14px)', desc: 'Small text, buttons, table cell labels', type: 'size' },
  { category: 'typography', name: '--ui-font-size-base', light: '1rem (16px)', dark: '1rem (16px)', desc: 'Standard body text and form inputs', type: 'size' },
  { category: 'typography', name: '--ui-font-size-lg', light: '1.125rem (18px)', dark: '1.125rem (18px)', desc: 'Card headings and featured paragraphs', type: 'size' },
  { category: 'typography', name: '--ui-font-size-xl', light: '1.25rem (20px)', dark: '1.25rem (20px)', desc: 'Section titles and modal headers', type: 'size' },
  { category: 'typography', name: '--ui-font-size-2xl', light: '1.5rem (24px)', dark: '1.5rem (24px)', desc: 'Page headers and hero banners', type: 'size' },

  { category: 'radius', name: '--ui-radius-sm', light: '0.375rem (6px)', dark: '0.375rem (6px)', desc: 'Small badges, chip tags, and tooltips', type: 'radius' },
  { category: 'radius', name: '--ui-radius-md', light: '0.5rem (8px)', dark: '0.5rem (8px)', desc: 'Default button, input, and card radius', type: 'radius' },
  { category: 'radius', name: '--ui-radius-lg', light: '0.75rem (12px)', dark: '0.75rem (12px)', desc: 'Dialog modals, sheets, and popovers', type: 'radius' },
  { category: 'radius', name: '--ui-radius-xl', light: '1rem (16px)', dark: '1rem (16px)', desc: 'Large panels and drawer sheets', type: 'radius' },
  { category: 'radius', name: '--ui-radius-full', light: '9999px', dark: '9999px', desc: 'Pill buttons, circular avatars, and badges', type: 'radius' },

  { category: 'shadow', name: '--ui-shadow-sm', light: '0 1px 2px rgba(0,0,0,0.05)', dark: '0 1px 2px rgba(0,0,0,0.3)', desc: 'Subtle elevation for cards and buttons', type: 'shadow' },
  { category: 'shadow', name: '--ui-shadow-md', light: '0 4px 6px -1px rgba(0,0,0,0.08)', dark: '0 4px 6px -1px rgba(0,0,0,0.4)', desc: 'Card hover elevation and dropdowns', type: 'shadow' },
  { category: 'shadow', name: '--ui-shadow-lg', light: '0 10px 15px -3px rgba(0,0,0,0.1)', dark: '0 10px 15px -3px rgba(0,0,0,0.5)', desc: 'Floating menus and search palettes', type: 'shadow' },
  { category: 'shadow', name: '--ui-shadow-popover', light: '0 12px 32px -4px rgba(15,23,42,0.18)', dark: '0 16px 36px -4px rgba(0,0,0,0.65)', desc: 'Top-layer anchored popovers and menus', type: 'shadow' },

  { category: 'glass', name: '--ui-glass-bg', light: 'rgba(255,255,255,0.82)', dark: 'rgba(9,9,11,0.85)', desc: 'Frosted glass translucent backdrop', type: 'glass' },
  { category: 'glass', name: '--ui-glass-border', light: 'rgba(228,228,231,0.8)', dark: 'rgba(39,39,42,0.8)', desc: 'Frosted glass boundary stroke', type: 'glass' },
  { category: 'glass', name: '--ui-glass-blur', light: 'blur(12px)', dark: 'blur(12px)', desc: 'Glassmorphic backdrop filter blur', type: 'glass' },

  { category: 'zindex', name: '--ui-z-dropdown', light: '1000', dark: '1000', desc: 'Anchored dropdown menus', type: 'zindex' },
  { category: 'zindex', name: '--ui-z-sticky', light: '1100', dark: '1100', desc: 'Sticky headers and navigation bars', type: 'zindex' },
  { category: 'zindex', name: '--ui-z-modal', light: '1350', dark: '1350', desc: 'Dialog modals and sheet drawers', type: 'zindex' },
  { category: 'zindex', name: '--ui-z-toast', light: '1500', dark: '1500', desc: 'Toast notifications floating container', type: 'zindex' },
  { category: 'zindex', name: '--ui-z-tooltip', light: '1600', dark: '1600', desc: 'Floating tooltips atop all layers', type: 'zindex' },

  { category: 'motion', name: '--ui-ease-spring', light: 'cubic-bezier(0.16, 1, 0.3, 1)', dark: 'cubic-bezier(0.16, 1, 0.3, 1)', desc: 'Natural fluid spring motion curve', type: 'motion' },
  { category: 'motion', name: '--ui-duration-fast', light: '150ms', dark: '150ms', desc: 'Instant feedback clicks and toggles', type: 'motion' },
  { category: 'motion', name: '--ui-duration-normal', light: '250ms', dark: '250ms', desc: 'Accordion expand and modal entrance', type: 'motion' },
];

const tokensArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': 'Design System Tokens & Global Theme Studio — All-In-One CSS Variables',
  'description': 'Interactive design tokens studio conforming to W3C DTCG standards. Configure 11-step tonal harmonies, border radii, and export turnkey CSS tokens.',
  'inLanguage': 'en-US',
  'author': {
    '@type': 'Organization',
    'name': 'NNUI-KIT Team',
    'url': 'https://github.com/harshp421/nnui-kit'
  }
};
---

<DocsLayout 
  title="Design System Tokens & Theme Studio — All-in-One CSS Variable Generator | NNUI-KIT" 
  description="Interactive design token studio conforming to W3C DTCG specs. Customize brand harmonies, dark modes, typography, and export production CSS variables in seconds."
  activePath="/tokens"
  keywords={[
    'design system tokens',
    'theme generator',
    'css variables studio',
    'w3c dtcg tokens',
    'tailwind css variables',
    'dark mode theme generator',
    'all-in-one design system',
    'color palette generator',
    'nnui'
  ]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Themes & Tokens', url: '/tokens' }
  ]}
  schema={[tokensArticleSchema]}
>
  <div class="page-container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    
    <!-- Header -->
    <div style="margin-bottom: 2.5rem;">
      <div class="announcement-badge" style="margin-bottom: 0.75rem;">W3C DTCG Specification Compliant · Universal Standalone CSS</div>
      <h1 style="font-size: 2.75rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 0.75rem; color: var(--text-main);">
        Design Tokens & Global Theme Studio
      </h1>
      <p style="color: var(--text-muted); font-size: 1.15rem; line-height: 1.6; max-width: 780px;">
        Interactive design token reference and export studio. Customize brand color harmonies, light/dark modes, and border radii in real time — then copy or download the turnkey global CSS theme file (<code style="color: var(--ui-color-brand-500); font-weight: 600;">globals.css</code>) directly into your product.
      </p>
    </div>

    <!-- Theme Studio Controls Toolbar -->
    <div class="theme-studio-toolbar">
      <!-- Quick Presets Row -->
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Quick Presets:</span>
          <button type="button" class="preset-chip-btn" data-preset="violet-dark">⚡ Electric Violet</button>
          <button type="button" class="preset-chip-btn" data-preset="emerald-dark">🌿 Emerald Forest</button>
          <button type="button" class="preset-chip-btn" data-preset="rose-light">🌸 Rose Daylight</button>
          <button type="button" class="preset-chip-btn" data-preset="blue-dark">💎 Modern Slate Blue</button>
          <button type="button" class="preset-chip-btn" data-preset="orange-dark">🔥 Sunset Orange</button>
          <button type="button" class="preset-chip-btn" data-preset="zinc-dark">🖤 Pure Monochrome</button>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <button id="copy-tokens-quick-btn" class="btn-brand" data-ui="button" data-size="xs" style="font-size: 0.78rem; padding: 0.35rem 0.85rem;" title="Copy complete globals.css to clipboard">
            <span>Copy globals.css 📋</span>
          </button>
          <button id="download-tokens-quick-btn" class="btn-secondary" data-ui="button" data-variant="secondary" data-size="xs" style="font-size: 0.78rem; padding: 0.35rem 0.85rem;" title="Download globals.css file">
            <span>Download .css ⬇️</span>
          </button>
        </div>
      </div>

      <!-- Controls: Palette, Mode, Radius -->
      <div class="theme-controls-row">
        <!-- Palette Selector -->
        <div class="theme-control-group" style="flex: 2; min-width: 280px;">
          <label class="theme-control-label">Brand Color Harmony (7 Palettes)</label>
          <div class="palette-swatch-pills" id="palette-pills-container">
            {palettes.map((p) => (
              <button 
                type="button"
                class="palette-pill-btn" 
                data-palette={p.name}
                title={p.label}
              >
                <span class="palette-pill-dot" style={`background-color: ${p.hex};`}></span>
                <span style="text-transform: capitalize;">{p.name}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Mode Selector -->
        <div class="theme-control-group" style="flex: 1; min-width: 140px;">
          <label class="theme-control-label">Color Mode</label>
          <div style="display: flex; gap: 0.35rem;">
            <button type="button" id="mode-btn-light" class="radius-pill-btn" style="flex: 1; text-align: center;">☀️ Light</button>
            <button type="button" id="mode-btn-dark" class="radius-pill-btn active" style="flex: 1; text-align: center;">🌙 Dark</button>
          </div>
        </div>

        <!-- Radius Selector -->
        <div class="theme-control-group" style="flex: 1.5; min-width: 220px;">
          <label class="theme-control-label">Border Radius</label>
          <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;" id="radius-pills-container">
            {radii.map((r) => (
              <button 
                type="button"
                class={`radius-pill-btn ${r.val === '0.5' ? 'active' : ''}`}
                data-radius={r.val}
              >
                {r.label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Live Component Showcase Matrix (Components Adapt in Real Time) -->
    <section style="margin-bottom: 4rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.25rem;">
        <div>
          <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0 0 0.25rem; color: var(--text-main);">Live Component Preview Matrix</h2>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">These live micro-enhancers and primitives adapt instantly to the theme, palette, and radius selections above.</p>
        </div>
        <span data-ui="badge" data-variant="secondary" style="font-size: 0.75rem;">
          Reactive Light-DOM
        </span>
      </div>

      <div class="theme-showcase-matrix">
        
        <!-- Card 1: Buttons & Actions -->
        <div data-ui="card" class="theme-showcase-card">
          <div class="theme-card-title">
            <span>Actions & Button Primitives</span>
            <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem;">Tier 0</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <!-- Primary Brand Button (Dynamic Accent) -->
            <button class="btn-brand" data-ui="button" id="demo-brand-btn" style="width: 100%; justify-content: center;">
              <span>Brand Accent Button ⚡</span>
            </button>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <button data-ui="button" data-variant="secondary" style="justify-content: center;">
                Secondary
              </button>
              <button data-ui="button" data-variant="outline" style="justify-content: center;">
                Outline
              </button>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <button data-ui="button" data-variant="ghost" style="justify-content: center;">
                Ghost Action
              </button>
              <button data-ui="button" data-variant="destructive" style="justify-content: center;">
                Destructive
              </button>
            </div>

            <!-- Toast Notification Trigger -->
            <button id="trigger-live-toast-btn" class="btn-secondary" data-ui="button" style="width: 100%; justify-content: center; font-size: 0.8rem; margin-top: 0.5rem;">
              <span>🔔 Trigger Toast Notification</span>
            </button>
          </div>
        </div>

        <!-- Card 2: Interactive Form & Inputs -->
        <div data-ui="card" class="theme-showcase-card">
          <div class="theme-card-title">
            <span>Form Controls & Sliders</span>
            <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem;">Interactive</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <!-- Input with Brand Focus -->
            <div>
              <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.35rem;">Project Name</label>
              <input 
                type="text" 
                data-ui="input" 
                class="ui-input" 
                value="my-universal-platform" 
                style="width: 100%; font-size: 0.85rem;"
              />
              <div data-ui="field-hint">Dynamically rings with active brand color on focus.</div>
            </div>

            <!-- Toggle Switch & Checkbox -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; background: var(--bg-secondary); border-radius: var(--ui-radius-md, 8px);">
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-main);">Cross-Tab Sync</span>
              <label data-ui="switch" style="cursor: pointer; display: inline-flex; align-items: center;">
                <input type="checkbox" checked style="accent-color: var(--ui-color-brand-500); width: 18px; height: 18px; cursor: pointer;" />
              </label>
            </div>

            <!-- Live Slider Component -->
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.35rem;">
                <span style="color: var(--text-main);">Performance Allocation</span>
                <span id="slider-val-readout" style="color: var(--ui-color-brand-500);">75%</span>
              </div>
              <input 
                id="theme-demo-slider" 
                type="range" 
                min="0" 
                max="100" 
                value="75" 
                style="width: 100%; accent-color: var(--ui-color-brand-500); cursor: pointer;"
              />
            </div>
          </div>
        </div>

        <!-- Card 3: Tabs, Badges & Segmented Control -->
        <div data-ui="card" class="theme-showcase-card">
          <div class="theme-card-title">
            <span>Navigation, Tabs & Badges</span>
            <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem;">Micro-Enhancer</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <!-- Segmented Control Role -->
            <div>
              <ui-segmented-control value="developer" style="width: 100%;">
                <button data-part="segment" data-value="viewer" style="flex: 1;">Viewer</button>
                <button data-part="segment" data-value="developer" style="flex: 1;">Developer</button>
                <button data-part="segment" data-value="admin" style="flex: 1;">Admin</button>
              </ui-segmented-control>
            </div>

            <!-- Tabs Component -->
            <ui-tabs value="overview" style="margin-top: 0.25rem;">
              <div data-part="tablist" style="margin-bottom: 0.75rem;">
                <button data-part="tab" data-value="overview" class="active">Overview</button>
                <button data-part="tab" data-value="deploy">Deployments</button>
                <button data-part="tab" data-value="audit">Audit Log</button>
              </div>
              <div data-part="tabpanel" data-value="overview">
                <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">
                  Active tab border and highlights automatically adhere to <code style="color: var(--ui-color-brand-500);">--ui-color-brand-500</code>.
                </div>
              </div>
              <div data-part="tabpanel" data-value="deploy" hidden>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Zero latency deployment pipeline active.</div>
              </div>
              <div data-part="tabpanel" data-value="audit" hidden>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Audited across 15 WAI-ARIA micro-enhancers.</div>
              </div>
            </ui-tabs>

            <!-- Badges Row -->
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
              <span class="btn-brand" style="font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: var(--ui-radius-full, 9999px);">Brand Filled</span>
              <span data-ui="badge" data-variant="secondary" style="font-size: 0.7rem;">Secondary</span>
              <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem;">Outline</span>
              <span data-ui="badge" style="font-size: 0.7rem; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Verified</span>
            </div>
          </div>
        </div>

        <!-- Card 4: Collapsible Accordion & Feedback -->
        <div data-ui="card" class="theme-showcase-card">
          <div class="theme-card-title">
            <span>Accordion & Feedback States</span>
            <span data-ui="badge" data-variant="outline" style="font-size: 0.7rem;">Light-DOM</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <!-- Live Vertical Accordion Component -->
            <ui-accordion type="single" collapsible style="width: 100%;">
              <div data-part="item" data-state="open" style="border: 1px solid var(--border-subtle); border-radius: var(--ui-radius-md, 8px); margin-bottom: 0.5rem; overflow: hidden;">
                <button data-part="trigger" style="width: 100%; padding: 0.65rem 0.85rem; display: flex; justify-content: space-between; align-items: center; background: var(--bg-secondary); border: none; font-size: 0.82rem; font-weight: 600; color: var(--text-main); cursor: pointer; text-align: left;">
                  <span>What makes NNUI-KIT themes unique?</span>
                  <span style="font-size: 0.75rem;">▾</span>
                </button>
                <div data-part="content" style="padding: 0.75rem 0.85rem; font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; background: var(--bg-card);">
                  Tokens live in CSS Cascade Layers (<code>@layer ui.tokens</code>) and bind directly to semantic HTML primitives without Shadow DOM style isolation barriers.
                </div>
              </div>

