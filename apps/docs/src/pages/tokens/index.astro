<script>
  import tokensData from 'nnui-kit/tokens.json';

  const palettePills = document.querySelectorAll('.palette-pill-btn');
  const radiusPills = document.querySelectorAll('.radius-pill-btn[data-radius]');
  const modeLightBtn = document.getElementById('mode-btn-light');
  const modeDarkBtn = document.getElementById('mode-btn-dark');
  const presetBtns = document.querySelectorAll('.preset-chip-btn');
  const statusTag = document.getElementById('active-theme-status-tag');
  const tabStatusPill = document.getElementById('tab-status-pill');

  const globalsCssOutput = document.getElementById('globals-css-output');
  const tailwindOutput = document.getElementById('tailwind-output');
  const overridesOutput = document.getElementById('overrides-output');

  const copyActiveBtn = document.getElementById('copy-active-tab-btn');
  const copyActiveLabel = document.getElementById('copy-active-tab-label');
  const downloadActiveBtn = document.getElementById('download-active-file-btn');
  const copyQuickBtn = document.getElementById('copy-tokens-quick-btn');
  const downloadQuickBtn = document.getElementById('download-tokens-quick-btn');

  const demoSlider = document.getElementById('theme-demo-slider') as HTMLInputElement | null;
  const sliderReadout = document.getElementById('slider-val-readout');
  const toastBtn = document.getElementById('trigger-live-toast-btn');

  const exportTabButtons = document.querySelectorAll('.token-tab-btn');
  const tabPanels = {
    globals: document.getElementById('panel-globals'),
    tailwind: document.getElementById('panel-tailwind'),
    overrides: document.getElementById('panel-overrides'),
    dictionary: document.getElementById('panel-dictionary'),
  };

  let activeTab = 'globals';

  // Palette HEX values map for 50-950
  const PALETTE_HEX_MAP: Record<string, Record<number, string>> = {
    zinc: { 50: '#fafafa', 100: '#f4f4f5', 200: '#e4e4e7', 300: '#d4d4d8', 400: '#a1a1aa', 500: '#71717a', 600: '#52525b', 700: '#3f3f46', 800: '#27272a', 900: '#18181b', 950: '#09090b' },
    slate: { 50: '#f8fafc', 100: '#f1f5f9', 200: '#e2e8f0', 300: '#cbd5e1', 400: '#94a3b8', 500: '#64748b', 600: '#475569', 700: '#334155', 800: '#1e293b', 900: '#0f172a', 950: '#020617' },
    violet: { 50: '#f5f3ff', 100: '#ede9fe', 200: '#ddd6fe', 300: '#c4b5fd', 400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9', 800: '#5b21b6', 900: '#4c1d95', 950: '#2e1065' },
    emerald: { 50: '#ecfdf5', 100: '#d1fae5', 200: '#a7f3d0', 300: '#6ee7b7', 400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857', 800: '#065f46', 900: '#064e3b', 950: '#022c22' },
    rose: { 50: '#fff1f2', 100: '#ffe4e6', 200: '#fecdd3', 300: '#fda4af', 400: '#fb7185', 500: '#f43f5e', 600: '#e11d48', 700: '#be123c', 800: '#9f1239', 900: '#881337', 950: '#4c0519' },
    blue: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a', 950: '#172554' },
    orange: { 50: '#fff7ed', 100: '#ffedd5', 200: '#fed7aa', 300: '#fdba74', 400: '#fb923c', 500: '#f97316', 600: '#ea580c', 700: '#c2410c', 800: '#9a3412', 900: '#7c2d12', 950: '#431407' },
  };

  let currentPalette = localStorage.getItem('nnui-palette') || 'zinc';
  let currentTheme = localStorage.getItem('nnui-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  let currentRadius = localStorage.getItem('nnui-radius') || '0.5';

  function applyStudioTheme() {
    // Apply attributes to root
    document.documentElement.setAttribute('data-palette', currentPalette);
    document.documentElement.setAttribute('data-theme', currentTheme);
    document.documentElement.setAttribute('data-radius', currentRadius);

    if (currentTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    // Persist to localStorage
    localStorage.setItem('nnui-palette', currentPalette);
    localStorage.setItem('nnui-theme', currentTheme);
    localStorage.setItem('nnui-radius', currentRadius);

    // Update Palette Pills UI
    palettePills.forEach((btn) => {
      const pal = btn.getAttribute('data-palette');
      if (pal === currentPalette) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Update Mode UI
    if (currentTheme === 'dark') {
      modeDarkBtn?.classList.add('active');
      modeLightBtn?.classList.remove('active');
    } else {
      modeLightBtn?.classList.add('active');
      modeDarkBtn?.classList.remove('active');
    }

    // Update Radius Pills UI
    radiusPills.forEach((btn) => {
      const rad = btn.getAttribute('data-radius');
      if (rad === currentRadius) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Update Status Tags
    const statusText = `${currentPalette.toUpperCase()} · ${currentTheme.toUpperCase()} · ${currentRadius} RADIUS`;
    if (statusTag) statusTag.textContent = statusText;
    if (tabStatusPill) tabStatusPill.textContent = statusText;

    // Update Swatch Hex Labels
    const hexMap = PALETTE_HEX_MAP[currentPalette] || PALETTE_HEX_MAP.zinc;
    document.querySelectorAll('.swatch-hex-label').forEach((label) => {
      const shade = Number(label.getAttribute('data-shade'));
      if (shade && hexMap[shade]) {
        label.textContent = hexMap[shade];
      }
    });

    // Generate Code for all tabs
    generateAllCode();
  }

  function getRadiusValues(rad: string) {
    if (rad === '0') return { sm: '0px', md: '0px', lg: '0px', xl: '0px', full: '9999px' };
    if (rad === 'full') return { sm: '9999px', md: '9999px', lg: '24px', xl: '32px', full: '9999px' };
    const num = parseFloat(rad);
    return {
      sm: `${(num * 0.75).toFixed(3)}rem`,
      md: `${num}rem`,
      lg: `${(num * 1.5).toFixed(3)}rem`,
      xl: `${(num * 2.0).toFixed(3)}rem`,
      full: '9999px',
    };
  }

  function generateAllCode() {
    const hexMap = PALETTE_HEX_MAP[currentPalette] || PALETTE_HEX_MAP.zinc;
    const radii = getRadiusValues(currentRadius);

    // 1. FULL GLOBALS.CSS CODE
    const globalsCode = `/**
 * NNUI-KIT — Design System Theme & Global CSS Variables
 * Palette: ${currentPalette.toUpperCase()} | Default Mode: ${currentTheme.toUpperCase()} | Radius: ${currentRadius}rem
 * W3C DTCG Specification Compliant · Universal Standalone CSS
 *
 * HOW TO USE IN YOUR PRODUCT:
 * 1. Save this file as 'globals.css' in your product (e.g. src/globals.css or app/globals.css).
 * 2. Import it at your application entrypoint:
 *    - Next.js:    import '@/styles/globals.css' in app/layout.tsx
 *    - Vite/React: import './globals.css' in src/main.tsx
 *    - Astro:      import '../styles/globals.css' in src/layouts/Layout.astro
 *    - HTML:       <link rel="stylesheet" href="globals.css">
 */

@layer ui.tokens {
  :root {
    /* ------------------------------------------------------------------------
     * Brand Color Palette (${currentPalette.toUpperCase()} 50–950)
     * ------------------------------------------------------------------------ */
    --ui-color-brand-50: ${hexMap[50]};
    --ui-color-brand-100: ${hexMap[100]};
    --ui-color-brand-200: ${hexMap[200]};
    --ui-color-brand-300: ${hexMap[300]};
    --ui-color-brand-400: ${hexMap[400]};
    --ui-color-brand-500: ${hexMap[500]};
    --ui-color-brand-600: ${hexMap[600]};
    --ui-color-brand-700: ${hexMap[700]};
    --ui-color-brand-800: ${hexMap[800]};
    --ui-color-brand-900: ${hexMap[900]};
    --ui-color-brand-950: ${hexMap[950]};

    /* Brand Accents & Status Feedback */
    --ui-color-accent-400: #38bdf8;
    --ui-color-accent-500: #0ea5e9;
    --ui-color-success-500: #10b981;
    --ui-color-warning-500: #f59e0b;
    --ui-color-danger-500: #ef4444;

    /* ------------------------------------------------------------------------
     * Semantic Surfaces & Backgrounds (Light Mode)
     * ------------------------------------------------------------------------ */
    --ui-bg-canvas: #ffffff;
    --ui-bg-surface: #ffffff;
    --ui-bg-surface-elevated: #f4f4f5;
    --ui-bg-subtle: #f4f4f5;
    --ui-bg-hover: #e4e4e7;
    --ui-bg-active: #d4d4d8;

    /* ------------------------------------------------------------------------
     * Semantic Text & Content (Light Mode)
     * ------------------------------------------------------------------------ */
    --ui-text-primary: #09090b;
    --ui-text-secondary: #52525b;
    --ui-text-muted: #71717a;
    --ui-text-inverted: #fafafa;

    /* ------------------------------------------------------------------------
     * Semantic Borders & Dividers (Light Mode)
     * ------------------------------------------------------------------------ */
    --ui-border-subtle: #f4f4f5;
    --ui-border-default: #e4e4e7;
    --ui-border-strong: #d4d4d8;
    --ui-border-focus: #09090b;

    /* Canonical Convenience Shorthand Aliases */
    --ui-bg: var(--ui-bg-canvas);
    --ui-text: var(--ui-text-primary);
    --ui-border: var(--ui-border-default);

    /* ------------------------------------------------------------------------
     * Typography Hierarchy
     * ------------------------------------------------------------------------ */
    --ui-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ui-font-mono: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace;
    --ui-font-size-xs: 0.75rem;    /* 12px */
    --ui-font-size-sm: 0.875rem;   /* 14px */
    --ui-font-size-base: 1rem;     /* 16px */
    --ui-font-size-lg: 1.125rem;   /* 18px */
    --ui-font-size-xl: 1.25rem;    /* 20px */
    --ui-font-size-2xl: 1.5rem;    /* 24px */
    --ui-font-size-3xl: 1.875rem;  /* 30px */

    /* ------------------------------------------------------------------------
     * Spacing Scale
     * ------------------------------------------------------------------------ */
    --ui-space-1: 0.25rem;   /* 4px */
    --ui-space-2: 0.5rem;    /* 8px */
    --ui-space-3: 0.75rem;   /* 12px */
    --ui-space-4: 1rem;      /* 16px */
    --ui-space-5: 1.25rem;   /* 20px */
    --ui-space-6: 1.5rem;    /* 24px */
    --ui-space-8: 2rem;      /* 32px */
    --ui-space-10: 2.5rem;   /* 40px */
    --ui-space-12: 3rem;     /* 48px */

    /* ------------------------------------------------------------------------
     * Border Radii (${currentRadius})
     * ------------------------------------------------------------------------ */
    --ui-radius-sm: ${radii.sm};
    --ui-radius-md: ${radii.md};
    --ui-radius-lg: ${radii.lg};
    --ui-radius-xl: ${radii.xl};
    --ui-radius-full: ${radii.full};

    /* ------------------------------------------------------------------------
     * Elevation & Box Shadows
     * ------------------------------------------------------------------------ */
    --ui-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --ui-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
    --ui-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.08);
    --ui-shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
    --ui-shadow-popover: 0 12px 32px -4px rgba(15, 23, 42, 0.18), 0 4px 12px -2px rgba(15, 23, 42, 0.08);

    /* ------------------------------------------------------------------------
     * Frosted Glassmorphism
     * ------------------------------------------------------------------------ */
    --ui-glass-bg: rgba(255, 255, 255, 0.82);
    --ui-glass-border: rgba(228, 228, 231, 0.8);
    --ui-glass-blur: blur(12px);

    /* ------------------------------------------------------------------------
     * Z-Index Layering Scale
     * ------------------------------------------------------------------------ */
    --ui-z-base: 0;
    --ui-z-dropdown: 1000;
    --ui-z-sticky: 1100;
    --ui-z-fixed: 1200;
    --ui-z-modal-backdrop: 1300;
    --ui-z-modal: 1350;
    --ui-z-popover: 1400;
    --ui-z-toast: 1500;
    --ui-z-tooltip: 1600;

    /* ------------------------------------------------------------------------
     * Motion & Easing Curves
     * ------------------------------------------------------------------------ */
    --ui-ease-in: cubic-bezier(0.4, 0, 1, 1);
    --ui-ease-out: cubic-bezier(0, 0, 0.2, 1);
    --ui-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
    --ui-ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
    --ui-ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

    --ui-duration-instant: 75ms;
    --ui-duration-fast: 150ms;
    --ui-duration-normal: 250ms;
    --ui-duration-slow: 400ms;

    --ui-transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --ui-transition-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --ui-transition-spring: 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* --------------------------------------------------------------------------
   * Dark Mode (Activate via .dark class or [data-theme="dark"])
   * -------------------------------------------------------------------------- */
  :root[data-theme="dark"],
  [data-theme="dark"],
  .dark {
    --ui-bg-canvas: #09090b;
    --ui-bg-surface: #09090b;
    --ui-bg-surface-elevated: #18181b;
    --ui-bg-subtle: #27272a;
    --ui-bg-hover: #27272a;
    --ui-bg-active: #3f3f46;

    --ui-text-primary: #fafafa;
    --ui-text-secondary: #a1a1aa;
    --ui-text-muted: #71717a;
    --ui-text-inverted: #09090b;

    --ui-border-subtle: #18181b;
    --ui-border-default: #27272a;
    --ui-border-strong: #3f3f46;
    --ui-border-focus: #fafafa;

    --ui-shadow-popover: 0 16px 36px -4px rgba(0, 0, 0, 0.65), 0 4px 16px -2px rgba(0, 0, 0, 0.5);
    --ui-glass-bg: rgba(9, 9, 11, 0.85);
    --ui-glass-border: rgba(39, 39, 42, 0.8);
  }

  /* Automatic OS Dark Mode */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]):not(.light) {
      --ui-bg-canvas: #09090b;
      --ui-bg-surface: #09090b;
      --ui-bg-surface-elevated: #18181b;
      --ui-bg-subtle: #27272a;
      --ui-bg-hover: #27272a;
      --ui-bg-active: #3f3f46;

      --ui-text-primary: #fafafa;
      --ui-text-secondary: #a1a1aa;
      --ui-text-muted: #71717a;
      --ui-text-inverted: #09090b;

      --ui-border-subtle: #18181b;
      --ui-border-default: #27272a;
      --ui-border-strong: #3f3f46;
      --ui-border-focus: #fafafa;

      --ui-shadow-popover: 0 16px 36px -4px rgba(0, 0, 0, 0.65), 0 4px 16px -2px rgba(0, 0, 0, 0.5);
      --ui-glass-bg: rgba(9, 9, 11, 0.85);
      --ui-glass-border: rgba(39, 39, 42, 0.8);
    }
  }

  /* Accessibility: Prefers Reduced Motion (WCAG 2.1 AA) */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Accessibility: Windows High Contrast / Forced Colors */
  @media (forced-colors: active) {
    :root {
      --ui-border-default: CanvasText;
      --ui-border-strong: CanvasText;
      --ui-border-focus: Highlight;
      --ui-bg-surface: Canvas;
      --ui-bg-surface-elevated: Canvas;
      --ui-text-primary: CanvasText;
    }
  }
}`;

    if (globalsCssOutput) globalsCssOutput.textContent = globalsCode;

    // 2. TAILWIND CSS CONFIG
    const tailwindCode = `/* ==========================================================================
 * Option A: Tailwind CSS v4 (@theme directive in your main CSS file)
 * ========================================================================== */
@import "tailwindcss";

@theme {
  /* Colors linked directly to NNUI-KIT tokens */
  --color-canvas: var(--ui-bg-canvas);
  --color-surface: var(--ui-bg-surface);
  --color-surface-elevated: var(--ui-bg-surface-elevated);
  --color-subtle: var(--ui-bg-subtle);

  --color-primary: var(--ui-text-primary);
  --color-secondary: var(--ui-text-secondary);
  --color-muted: var(--ui-text-muted);

  --color-border-subtle: var(--ui-border-subtle);
  --color-border: var(--ui-border-default);
  --color-border-strong: var(--ui-border-strong);

  --color-brand-50: var(--ui-color-brand-50);
  --color-brand-500: var(--ui-color-brand-500);
  --color-brand-600: var(--ui-color-brand-600);
  --color-brand-900: var(--ui-color-brand-900);

  /* Border Radii */
  --radius-sm: var(--ui-radius-sm);
  --radius-md: var(--ui-radius-md);
  --radius-lg: var(--ui-radius-lg);
  --radius-xl: var(--ui-radius-xl);

  /* Shadows */
  --shadow-popover: var(--ui-shadow-popover);
}

/* ==========================================================================
 * Option B: Tailwind CSS v3 (tailwind.config.js)
 * ========================================================================== */
/** @type {import('tailwindcss').Config} */
module.exports = {
  darkMode: ['class', '[data-theme="dark"]'],
  theme: {
    extend: {
      colors: {
        canvas: 'var(--ui-bg-canvas)',
        surface: {
          DEFAULT: 'var(--ui-bg-surface)',
          elevated: 'var(--ui-bg-surface-elevated)',
          subtle: 'var(--ui-bg-subtle)',
        },
        content: {
          primary: 'var(--ui-text-primary)',
          secondary: 'var(--ui-text-secondary)',
          muted: 'var(--ui-text-muted)',
        },
        border: {
          DEFAULT: 'var(--ui-border-default)',
          subtle: 'var(--ui-border-subtle)',
          strong: 'var(--ui-border-strong)',
        },
        brand: {
          50: 'var(--ui-color-brand-50)',
          100: 'var(--ui-color-brand-100)',
          500: 'var(--ui-color-brand-500)',
          600: 'var(--ui-color-brand-600)',
          900: 'var(--ui-color-brand-900)',
        },
      },
      borderRadius: {
        sm: 'var(--ui-radius-sm)',
        DEFAULT: 'var(--ui-radius-md)',
        md: 'var(--ui-radius-md)',
        lg: 'var(--ui-radius-lg)',
        xl: 'var(--ui-radius-xl)',
      },
      boxShadow: {
        popover: 'var(--ui-shadow-popover)',
      },
    },
  },
};`;

    if (tailwindOutput) tailwindOutput.textContent = tailwindCode;

    // 3. TOKENS.CSS OVERRIDES ONLY
    const overridesCode = `/* NNUI-KIT W3C DTCG Token Customization */
:root[data-palette="${currentPalette}"], 
[data-palette="${currentPalette}"] {
  --ui-color-brand-50: ${hexMap[50]};
  --ui-color-brand-100: ${hexMap[100]};
  --ui-color-brand-200: ${hexMap[200]};
  --ui-color-brand-300: ${hexMap[300]};
  --ui-color-brand-400: ${hexMap[400]};
  --ui-color-brand-500: ${hexMap[500]};
  --ui-color-brand-600: ${hexMap[600]};
  --ui-color-brand-700: ${hexMap[700]};
  --ui-color-brand-800: ${hexMap[800]};
  --ui-color-brand-900: ${hexMap[900]};
  --ui-color-brand-950: ${hexMap[950]};

  /* Border Radius Override (${currentRadius}rem) */
  --ui-radius-sm: ${radii.sm};
  --ui-radius-md: ${radii.md};
  --ui-radius-lg: ${radii.lg};
  --ui-radius-xl: ${radii.xl};
  --ui-radius-full: ${radii.full};
}`;

    if (overridesOutput) overridesOutput.textContent = overridesCode;
  }

  // Bind Palette Pill Clicks
  palettePills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pal = btn.getAttribute('data-palette');
      if (pal) {
        currentPalette = pal;
        applyStudioTheme();
      }
    });
  });

  // Bind Mode Clicks
  modeLightBtn?.addEventListener('click', () => {
    currentTheme = 'light';
    applyStudioTheme();
  });

  modeDarkBtn?.addEventListener('click', () => {
    currentTheme = 'dark';
    applyStudioTheme();
  });

  // Bind Radius Clicks
  radiusPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const rad = btn.getAttribute('data-radius');
      if (rad) {
        currentRadius = rad;
        applyStudioTheme();
      }
    });
  });

  // Bind Presets
  const PRESET_MAP: Record<string, { palette: string; theme: string; radius: string; title: string }> = {
    'violet-dark': { palette: 'violet', theme: 'dark', radius: '0.5', title: 'Electric Violet' },
    'emerald-dark': { palette: 'emerald', theme: 'dark', radius: '0.75', title: 'Emerald Forest' },
    'rose-light': { palette: 'rose', theme: 'light', radius: '0.5', title: 'Rose Daylight' },
    'blue-dark': { palette: 'blue', theme: 'dark', radius: '0.3', title: 'Modern Slate Blue' },
    'orange-dark': { palette: 'orange', theme: 'dark', radius: '1.0', title: 'Sunset Orange' },
    'zinc-dark': { palette: 'zinc', theme: 'dark', radius: '0.5', title: 'Pure Monochrome' },
  };

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const presetKey = btn.getAttribute('data-preset');
      if (presetKey && PRESET_MAP[presetKey]) {
        const p = PRESET_MAP[presetKey];
        currentPalette = p.palette;
        currentTheme = p.theme;
        currentRadius = p.radius;
        applyStudioTheme();

        if ((window as any).toast) {
          (window as any).toast.success(`Preset Applied: ${p.title}`);
        }
      }
    });
  });

  // Bind Interactive Slider
  if (demoSlider && sliderReadout) {
    demoSlider.addEventListener('input', (e: any) => {
      sliderReadout.textContent = `${e.target.value}%`;
    });
  }

  // Bind Live Toast Button
  if (toastBtn) {
    toastBtn.addEventListener('click', () => {
      if ((window as any).toast) {
        (window as any).toast.success(`Theme Applied: ${currentPalette.toUpperCase()} · ${currentTheme.toUpperCase()} mode!`, {
          title: 'Theme Customizer',
          duration: 3500
        });
      }
    });
  }

  // Bind Swatch Click-to-Copy
  document.querySelectorAll('.swatch-card').forEach((card) => {
    card.addEventListener('click', () => {
      const shade = card.getAttribute('data-shade');
      const hex = card.querySelector('.swatch-hex-label')?.textContent || '';
      navigator.clipboard.writeText(hex).then(() => {
        if ((window as any).toast) {
          (window as any).toast.success(`Copied ${hex} (--ui-color-brand-${shade})`);
        }
      });
    });
  });

  // Export Tab Navigation
  exportTabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = btn.getAttribute('data-tab');
      if (!tabName) return;

      activeTab = tabName;

      // Update button active state
      exportTabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      // Update panel visibility
      Object.entries(tabPanels).forEach(([key, panel]) => {
        if (panel) {
          panel.style.display = key === tabName ? 'block' : 'none';
        }
      });

      // Update copy button label
      if (copyActiveLabel) {
        if (tabName === 'globals') copyActiveLabel.textContent = 'Copy globals.css 📋';
        else if (tabName === 'tailwind') copyActiveLabel.textContent = 'Copy Tailwind Config 📋';
        else if (tabName === 'overrides') copyActiveLabel.textContent = 'Copy Overrides 📋';
        else copyActiveLabel.textContent = 'Copy All CSS Variables 📋';
      }
    });
  });

  // Download CSS File Helper
  function triggerDownload(filename: string, content: string) {
    const blob = new Blob([content], { type: 'text/css;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    if ((window as any).toast) {
      (window as any).toast.success(`Downloaded ${filename} successfully!`);
    }
  }

  // Get active code text
  function getActiveCodeText() {
    if (activeTab === 'globals') return globalsCssOutput?.textContent || '';
    if (activeTab === 'tailwind') return tailwindOutput?.textContent || '';
    if (activeTab === 'overrides') return overridesOutput?.textContent || '';
    return globalsCssOutput?.textContent || '';
  }

  // Copy Active Code
  function copyActiveCode() {
    const text = getActiveCodeText();
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      if ((window as any).toast) {
        const file = activeTab === 'globals' ? 'globals.css' : activeTab === 'tailwind' ? 'Tailwind config' : 'tokens.css';
        (window as any).toast.success(`${file} copied to clipboard! Ready to paste into your product.`);
      }

      if (copyActiveLabel) {
        const original = copyActiveLabel.textContent;
        copyActiveLabel.textContent = '✓ Copied to Clipboard!';
        setTimeout(() => { copyActiveLabel.textContent = original; }, 2000);
      }
    });
  }

  copyActiveBtn?.addEventListener('click', copyActiveCode);
  copyQuickBtn?.addEventListener('click', () => {
    activeTab = 'globals';
    copyActiveCode();
  });

  // Download Active Code
  downloadActiveBtn?.addEventListener('click', () => {
    const filename = activeTab === 'globals' ? 'globals.css' : activeTab === 'tailwind' ? 'tailwind-tokens.css' : 'tokens.css';
    triggerDownload(filename, getActiveCodeText());
  });

  downloadQuickBtn?.addEventListener('click', () => {
    triggerDownload('globals.css', globalsCssOutput?.textContent || '');
  });

  // Token Dictionary Search & Category Filter
  const dictSearchInput = document.getElementById('token-dict-search-input') as HTMLInputElement | null;
  const dictFilterBtns = document.querySelectorAll('.token-dict-filter-btn');
  const dictRows = document.querySelectorAll('.token-dict-row');

  let activeCategory = 'all';

  function filterDictionary() {
    const query = dictSearchInput?.value.trim().toLowerCase() || '';

    dictRows.forEach((row) => {
      const cat = row.getAttribute('data-category') || '';
      const text = row.getAttribute('data-search') || '';

      const matchesCat = activeCategory === 'all' || cat === activeCategory;
      const matchesQuery = !query || text.includes(query);

      (row as HTMLElement).style.display = matchesCat && matchesQuery ? '' : 'none';
    });
  }

  dictSearchInput?.addEventListener('input', filterDictionary);

  dictFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      activeCategory = filter;

      dictFilterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      filterDictionary();
    });
  });

  // Token Variable Click-to-Copy
  document.querySelectorAll('.copy-token-var-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const varName = btn.getAttribute('data-var');
      if (varName) {
        navigator.clipboard.writeText(`var(${varName})`).then(() => {
          if ((window as any).toast) {
            (window as any).toast.success(`Copied var(${varName})`);
          }
        });
      }
    });
  });

  // Initialize on page load
  applyStudioTheme();

  // Listen for palette change from header ui-dropdown
  window.addEventListener('nnui-palette-changed', (e: any) => {
    if (e.detail?.palette) {
      currentPalette = e.detail.palette;
      applyStudioTheme();
    }
  });
</script>

