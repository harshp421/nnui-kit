---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";

const svelteSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "NNUI-KIT Svelte 5 & SvelteKit Installation Guide",
  description:
    "Step-by-step instructions to install and configure NNUI-KIT in Svelte 5 and SvelteKit. Works with Runes ($state, $props) and zero Shadow DOM traps.",
  author: {
    "@type": "Organization",
    name: "NNUI-KIT Team",
    url: "https://github.com/harshp421/nnui-kit",
  },
};
---

<DocsLayout
  title="Svelte 5 & SvelteKit Installation — NNUI-KIT"
  description="Install and configure NNUI-KIT in Svelte 5 and SvelteKit. Learn how to import design tokens, mount the client engine, and use Svelte 5 Runes."
  activePath="/docs/installation/svelte"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Docs", url: "/docs" },
    { name: "Installation", url: "/docs/installation" },
    { name: "Svelte", url: "/docs/installation/svelte" },
  ]}
  schema={svelteSchema}
>
  <div class="docs-layout-container">
    <DocsSidebar activePath="/docs/installation/svelte" />

    <main class="docs-body">
      <!-- Breadcrumbs -->
      <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="docs-breadcrumbs-sep">/</span>
        <a href="/docs">Docs</a>
        <span class="docs-breadcrumbs-sep">/</span>
        <a href="/docs/installation">Installation</a>
        <span class="docs-breadcrumbs-sep">/</span>
        <span class="docs-breadcrumbs-current">Svelte 5</span>
      </nav>

      <!-- Page Header -->
      <header style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
          <div
            class="framework-card-icon"
            style="width: 36px; height: 36px; margin-bottom: 0; background: rgba(255, 62, 0, 0.12); color: #ff3e00;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </div>
          <h1
            style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em; margin: 0; color: var(--text-main);"
          >
            Svelte 5 & SvelteKit
          </h1>
        </div>
        <p
          style="font-size: 1.15rem; color: var(--text-muted); line-height: 1.6; margin: 0; max-width: 720px;"
        >
          Install and configure NNUI-KIT for Svelte 5 and SvelteKit using the modern Runes architecture.
        </p>
      </header>

      <!-- Steps List -->
      <div class="installation-steps">
        <!-- Step 1: Create project -->
        <div class="step-item">
          <div class="step-num">1</div>
          <div class="step-content">
            <h2 class="step-title">Create project</h2>
            <p class="step-desc">
              Create a new SvelteKit project using <code>create-svelte</code>:
            </p>
            <div class="code-block-box">
              <div class="code-block-header">
                <span>Terminal</span>
                <span>bash</span>
              </div>
              <pre><code>npm create svelte@latest my-app
cd my-app</code></pre>
            </div>
          </div>
        </div>

        <!-- Step 2: Install dependencies -->
        <div class="step-item">
          <div class="step-num">2</div>
          <div class="step-content">
            <h2 class="step-title">Install NNUI-KIT</h2>
            <p class="step-desc">
              Install the package from npm:
            </p>
            <div class="code-block-box">
              <div class="code-block-header">
                <span>Terminal</span>
                <span>bash</span>
              </div>
              <pre><code>npm install nnuikit</code></pre>
            </div>
          </div>
        </div>

        <!-- Step 3: Configure Root Layout -->
        <div class="step-item">
          <div class="step-num">3</div>
          <div class="step-content">
            <h2 class="step-title">Configure Root Layout & Tokens</h2>
            <p class="step-desc">
              Import the design token stylesheet and mount the client engine in <code>src/routes/+layout.svelte</code>:
            </p>

            <div class="code-block-box">
              <div class="code-block-header">
                <span>src/routes/+layout.svelte</span>
                <span>svelte</span>
              </div>
              <pre><code>&lt;script&gt;
  // 1. Import NNUI design tokens (CSS variables & cascade layers)
  import 'nnuikit/tokens/theme.css';
  import &#123; onMount &#125; from 'svelte';

  // 2. Hydrate Light-DOM client runtime in the browser
  onMount(async () =&gt; &#123;
    await import('nnuikit/client');
  &#125;);

  let &#123; children &#125; = $props();
&lt;/script&gt;

&lt;div data-theme="dark"&gt;
  &#123;@render children()&#125;
&lt;/div&gt;</code></pre>
            </div>
          </div>
        </div>

        <!-- Step 4: Add components -->
        <div class="step-item">
          <div class="step-num">4</div>
          <div class="step-content">
            <h2 class="step-title">Add components using Svelte 5 Runes</h2>
            <p class="step-desc">
              Use standard HTML Light-DOM primitives with Svelte 5 <code>$state</code>:
            </p>

            <div class="code-block-box">
              <div class="code-block-header">
                <span>src/routes/+page.svelte</span>
                <span>svelte</span>
              </div>
              <pre><code>&lt;script&gt;
  let email = $state('');
  let count = $state(0);
&lt;/script&gt;

&lt;main style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem;"&gt;
  &lt;div data-ui="card" style="width: 100%; max-width: 440px; padding: 2rem; display: flex; flex-direction: column; gap: 1.25rem;"&gt;
    &lt;div style="display: flex; justify-content: space-between; align-items: center;"&gt;
      &lt;h1 style="margin: 0; font-size: 1.35rem; font-weight: 700;"&gt;Svelte 5 + NNUI-KIT&lt;/h1&gt;
      &lt;span data-ui="badge" data-variant="primary"&gt;Runes&lt;/span&gt;
    &lt;/div&gt;

    &lt;p style="margin: 0; color: var(--ui-text-secondary, #a1a1aa); font-size: 0.875rem;"&gt;
      Zero Shadow DOM traps. Native browser custom elements paired with Svelte Runes.
    &lt;/p&gt;

    &lt;input data-ui="input" bind:value=&#123;email&#125; placeholder="Enter your email..." type="email" /&gt;

    &lt;button data-ui="button" data-variant="primary" onclick=&#123;() =&gt; count++&#125;&gt;
      Clicked &#123;count&#125; times
    &lt;/button&gt;
  &lt;/div&gt;
&lt;/main&gt;</code></pre>
            </div>
          </div>
        </div>

        <!-- Step 5: Run dev server -->
        <div class="step-item">
          <div class="step-num">5</div>
          <div class="step-content">
            <h2 class="step-title">Run development server</h2>
            <p class="step-desc">
              Start the SvelteKit development server:
            </p>
            <div class="code-block-box">
              <div class="code-block-header">
                <span>Terminal</span>
                <span>bash</span>
              </div>
              <pre><code>npm run dev</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Next Navigation -->
      <div
        style="border-top: 1px solid var(--border-subtle); padding-top: 2rem; margin-top: 3rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;"
      >
        <a
          href="/docs/installation"
          class="btn-secondary"
          style="font-size: 0.85rem;"
        >
          ← All Frameworks
        </a>
        <a
          href="/components"
          class="btn-primary"
          style="font-size: 0.85rem;"
        >
          Explore All Components →
        </a>
      </div>
    </main>
  </div>
</DocsLayout>
