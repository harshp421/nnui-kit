---
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";

const docsArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "NNUI-KIT: The All-In-One Universal Light-DOM UI Architecture",
  description:
    "Comprehensive architectural guide to NNUI-KIT. Explains three-tier Light-DOM components, zero Shadow DOM accessibility traps, declarative URL state persistence, cross-tab broadcast sync, and universal framework adapters.",
  inLanguage: "en-US",
  author: {
    "@type": "Organization",
    name: "NNUI-KIT Team",
    url: "https://github.com/harshp421/nnui-kit",
  },
  publisher: {
    "@type": "Organization",
    name: "NNUI-KIT",
    logo: {
      "@type": "ImageObject",
      url: "https://nnui-kit.vercel.app/logo.png",
    },
  },
};

const docsFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the Three-Tier Architecture in NNUI-KIT?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "NNUI-KIT organizes components into 3 strict tiers: Tier 0 consists of 17 zero-JS semantic primitives (buttons, inputs, cards, badges); Tier 1 is headless functional behavioral engines; and Tier 2 consists of 28 micro-enhancers (custom elements like ui-data-grid, ui-stepper, ui-tabs) living strictly in the Light DOM without Shadow DOM barriers.",
      },
    },
    {
      "@type": "Question",
      name: "Why is NNUI-KIT built with Light-DOM instead of Shadow DOM?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Shadow DOM isolates component markup inside shadow roots, which fundamentally breaks screen reader ARIA hierarchies, prevents form data submission via standard HTML forms, and blocks global Tailwind and CSS cascades. Light-DOM keeps the DOM completely open, accessible, and style-transparent.",
      },
    },
    {
      "@type": "Question",
      name: "How does NNUI-KIT achieve declarative persistence and cross-tab sync without libraries?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'NNUI-KIT components observe declarative attributes. Adding persist="url" hooks into history.replaceState to sync component values to URL search parameters. Adding sync="cross-tab" binds to the browser BroadcastChannel API to mirror state across multiple browser tabs in real-time.',
      },
    },
  ],
};
---

<DocsLayout
  title="All-in-One Light-DOM Universal UI Architecture Documentation | NNUI-KIT"
  description="Comprehensive guide to NNUI-KIT: the all-in-one universal Light-DOM UI architecture. Learn the 3-tier mental model, declarative persistence, cross-tab sync, and React 19/Vue/Svelte setup."
  activePath="/docs"
  keywords={[
    "all in one ui documentation",
    "universal ui kit architecture",
    "light dom web components",
    "zero shadow dom",
    "three tier architecture",
    "state persistence",
    "cross tab broadcast sync",
    "ai introspection protocol",
    "react 19 ui kit",
    "vue 3 ui components",
    "svelte 5 runes",
    "astro components",
  ]}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Docs", url: "/docs" },
  ]}
  schema={[docsArticleSchema, docsFaqSchema]}
>
  <div class="docs-layout-container">
    <DocsSidebar activePath="/docs" />

    <!-- Main Docs Content -->
    <main class="docs-body">
      <!-- Introduction -->
      <section id="introduction" style="margin-bottom: 4rem;">
        <h1
          style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 1rem; color: var(--text-main);"
        >
          Introduction & Architecture
        </h1>
        <p
          style="font-size: 1.15rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;"
        >
          NNUI-KIT is a platform-native, three-tier Light-DOM universal UI
          system. It delivers accessible, composable interface components that
          execute identically across every modern web framework with zero Shadow
          DOM barriers and sub-40 KB runtime footprint.
        </p>

        <!-- Quick Action Hub for Developers -->
        <div class="docs-quick-links-grid">
          <a href="/docs/installation" class="docs-quick-link-card">
            <div class="docs-quick-link-header">
              <span class="docs-quick-link-title">
                <span>📦</span>
                <span>Framework Installation</span>
              </span>
              <span class="docs-version-pill" style="border-color: #10b981; color: #10b981; font-size: 0.65rem;">7 Stacks</span>
            </div>
            <p class="docs-quick-link-desc">
              Tailored guides for Next.js 15, Vite (React 18/19), Astro, Vue 3, Svelte 5, Remix, and Vanilla HTML.
            </p>
          </a>

          <a href="/components" class="docs-quick-link-card">
            <div class="docs-quick-link-header">
              <span class="docs-quick-link-title">
                <span>🧩</span>
                <span>Component Library</span>
              </span>
              <span class="docs-version-pill" style="font-size: 0.65rem;">45+ Primitives</span>
            </div>
            <p class="docs-quick-link-desc">
              Accessible buttons, virtualized Data Grid, Dialog, Stepper, Tabs, Toast, and micro-enhancers.
            </p>
          </a>

          <a href="/tokens" class="docs-quick-link-card">
            <div class="docs-quick-link-header">
              <span class="docs-quick-link-title">
                <span>🎨</span>
                <span>Theme Studio</span>
              </span>
              <span class="docs-version-pill" style="font-size: 0.65rem;">Live Customizer</span>
            </div>
            <p class="docs-quick-link-desc">
              Test DTCG color palettes, typography scale, and border radii with real-time CSS token export.
            </p>
          </a>

          <a href="/shadow-vs-light" class="docs-quick-link-card">
            <div class="docs-quick-link-header">
              <span class="docs-quick-link-title">
                <span>⚖️</span>
                <span>Light vs Shadow DOM</span>
              </span>
              <span class="docs-version-pill" style="border-color: #10b981; color: #10b981; font-size: 0.65rem;">Manifesto</span>
            </div>
            <p class="docs-quick-link-desc">
              Why we eliminated the Shadow Root: zero accessibility barriers, form participation & Tailwind compatibility.
            </p>
          </a>
        </div>


        <!-- AEO Quick Summary for Docs Page -->
        <div
          class="aeo-summary-box"
          data-ui="card"
          style="margin-bottom: 2rem; background: color-mix(in srgb, var(--ui-color-brand-500) 6%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--ui-color-brand-500) 22%, var(--border-subtle)); border-radius: 10px; padding: 1rem 1.25rem;"
        >
          <div
            style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;"
          >
            <span
              style="font-size: 0.75rem; font-weight: 800; background: var(--ui-color-brand-500); color: #fff; padding: 2px 6px; border-radius: 4px;"
              >AEO</span
            >
            <strong style="color: var(--text-main); font-size: 0.92rem;"
              >At a Glance: The Universal Light-DOM Principle</strong
            >
          </div>
          <p
            style="margin: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.55;"
          >
            NNUI-KIT solves the web component dilemma by keeping all elements in
            the <strong>Light DOM</strong> while using custom elements strictly as
            behavioral micro-enhancers that <em
              >"Mutate Attributes, Never Nodes"</em
            >. This gives you 100% code ownership, zero Shadow DOM accessibility
            traps, native form participation, and seamless compatibility with
            React 19, Vue 3, Svelte 5, Astro, and SSR frameworks.
          </p>
        </div>

        <!-- 3-Tier Architecture Flow -->
        <div
          id="mental-model"
          data-ui="card"
          style="border: 1px solid var(--border-subtle); border-radius: 12px; padding: 2rem; background: var(--bg-card); margin-bottom: 2.5rem;"
        >
          <h2
            style="font-size: 1.35rem; font-weight: 700; margin-top: 0; margin-bottom: 1.25rem; color: var(--text-main);"
          >
            Three-Tier Architecture
          </h2>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div
              data-ui="card"
              style="padding: 1.25rem; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--bg-secondary);"
            >
              <div
                style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;"
              >
                <strong style="color: var(--text-main); font-size: 0.95rem;"
                  >Tier 0: Pure Semantic Primitives (17 Zero-JS Controls)</strong
                >
                <span class="docs-version-pill" data-ui="badge">Zero JS</span>
              </div>
              <p
                style="margin: 0; font-size: 0.85rem; color: var(--text-muted);"
              >
                Buttons, Badges, Inputs, Checkboxes, Switches, Cards, Skeletons,
                Dividers, Grid & Stack layouts. Render instantly via CSS Cascade
                Layers (<code>@layer ui.base</code>).
              </p>
            </div>

            <div
              data-ui="card"
              style="padding: 1.25rem; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--bg-secondary);"
            >
              <div
                style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;"
              >
                <strong style="color: var(--text-main); font-size: 0.95rem;"
                  >Tier 1: Design Tokens & CSS Cascade Layers</strong
                >
                <span class="docs-version-pill" data-ui="badge">W3C DTCG</span>
              </div>
              <p
                style="margin: 0; font-size: 0.85rem; color: var(--text-muted);"
              >
                W3C DTCG tokens specification with 6 color palettes (Zinc,
                Slate, Neutral, Violet, Rose, Emerald). Layered defensively
                across <code
                  >@layer ui.tokens, ui.base, ui.components, ui.overrides</code
                >.
              </p>
            </div>

            <div
              data-ui="card"
              style="padding: 1.25rem; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--bg-secondary);"
            >
              <div
                style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;"
              >
                <strong style="color: var(--text-main); font-size: 0.95rem;"
                  >Tier 2: Micro-Enhancers (28 Light-DOM Custom Elements)</strong
                >
                <span
                  class="docs-version-pill"
                  data-ui="badge"
                  style="border-color: #10b981; color: #10b981;">Sub-40 KB</span
                >
              </div>
              <p
                style="margin: 0; font-size: 0.85rem; color: var(--text-muted);"
              >
                Virtualized Data Grid (>15k rows), Date Range Picker, Combobox,
                Dialog, Stepper, AI Prompt Box, Tabs. 100% Light-DOM custom
                elements with <code>ElementInternals</code> form association.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Light-DOM? Table -->
      <section id="why-light-dom" style="margin-bottom: 4rem;">
        <h2
          style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; color: var(--text-main);"
        >
          Why Light-DOM? (Solving Shadow DOM Traps)
        </h2>
        <p
          style="font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.5rem;"
        >
          Traditional Web Component libraries seal templates inside closed
          Shadow DOM roots. While isolation sounds good initially, it creates
          severe accessibility, styling, and form participation bottlenecks in
          production applications:
        </p>

        <div
          style="overflow-x: auto; border: 1px solid var(--border-subtle); border-radius: 10px; background: var(--bg-card);"
        >
          <table
            data-ui="table"
            class="ui-table"
            style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;"
          >
            <thead>
              <tr
                style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-subtle);"
              >
                <th style="padding: 0.85rem 1.25rem;">Dimension</th>
                <th style="padding: 0.85rem 1.25rem; color: #ef4444;"
                  >Shadow DOM Libraries</th
                >
                <th style="padding: 0.85rem 1.25rem; color: #10b981;"
                  >NNUI-KIT (Light-DOM)</th
                >
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1.25rem; font-weight: 600;"
                  >Global CSS & Tailwind</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);"
                  >Blocked by boundary (requires ::part())</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-main);"
                  >Directly styled by standard classes & @layer cascade</td
                >
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1.25rem; font-weight: 600;"
                  >Form Participation</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);"
                  >Requires synthetic hidden input injection hacks</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-main);"
                  >Native ElementInternals & FormData auto-serialization</td
                >
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1.25rem; font-weight: 600;"
                  >Screen Readers (A11y)</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);"
                  >Fragmented accessibility tree; broken aria-labelledby IDs</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-main);"
                  >Unbroken DOM tree; standard document ID references</td
                >
              </tr>
              <tr>
                <td style="padding: 0.85rem 1.25rem; font-weight: 600;"
                  >Framework V-DOM</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);"
                  >Hydration mismatch and node duplication conflicts</td
                >
                <td style="padding: 0.85rem 1.25rem; color: var(--text-main);"
                  >"Mutate Attributes, Never Nodes" — 100% V-DOM safe</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Installation & Quickstart -->
      <section id="installation" style="margin-bottom: 4rem;">
        <h2
          style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; color: var(--text-main);"
        >
          Installation & Setup
        </h2>
        <p
          style="font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1rem;"
        >
          Install via npm or use the registry CLI to drop zero-dependency custom
          elements and copy-pasteable CSS theme tokens directly into your
          project:
        </p>

        <!-- Framework Selection Hub Banner -->
        <div
          data-ui="card"
          style="margin-bottom: 2rem; background: color-mix(in srgb, var(--ui-color-brand-500) 8%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--ui-color-brand-500) 25%, var(--border-subtle)); border-radius: 10px; padding: 1.25rem 1.5rem;"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
            <div>
              <strong style="color: var(--text-main); font-size: 1.05rem; display: block; margin-bottom: 0.25rem;">
                Looking for framework-specific installation guides?
              </strong>
              <p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
                View dedicated step-by-step guides for Vite (React), Next.js 15, Astro, Vue 3, Svelte 5, Remix, and Vanilla HTML.
              </p>
            </div>
            <a href="/docs/installation" class="btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
              Select Your Framework →
            </a>
          </div>
        </div>

        <pre
          class="code-viewer-pre"
          style="border-radius: 8px; border: 1px solid var(--border-subtle); margin-bottom: 1.5rem;"><code># 1. Install universal package
npm install nnuikit

# 2. Or initialize the CLI (automatically generates theme.css and tokens in your app)
npx nnui init

# 3. Add components with your specific framework target:
npx nnui add dialog --react   # Drops React compound component into src/components/ui/
npx nnui add dialog --html    # Drops vanilla HTML snippet & JS micro-enhancer
npx nnui add dialog --rails   # Drops Rails ERB partial & configures importmap.rb</code></pre>

        <!-- Framework Targets Card -->
        <div
          data-ui="card"
          style="border: 1px solid var(--border-subtle); border-radius: 10px; padding: 1.5rem; background: var(--bg-card); margin-bottom: 1.5rem;"
        >
          <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;"
          >
            <div
              style="font-weight: 700; color: var(--text-main); font-size: 1rem; display: flex; align-items: center; gap: 0.5rem;"
            >
              <span>🚀</span>
              <span>Framework Targets: True Code Ownership Across Stacks</span>
            </div>
            <span
              class="docs-version-pill"
              style="border-color: var(--ui-color-brand-500); color: var(--ui-color-brand-500);"
              >CLI v1.0.7</span
            >
          </div>
          <p
            style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1rem;"
          >
            Unlike shadcn/ui (locked to React) or traditional web components
            (locked in Shadow DOM), NNUI-KIT provides <strong
              >100% Light-DOM code ownership</strong
            > across modern frontend and server-rendered stacks. Run the CLI with
            your framework target:
          </p>

          <ui-tabs value="react" style="width: 100%; display: block;">
            <div
              data-part="tablist"
              style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem; margin-bottom: 1rem; overflow-x: auto;"
            >
              <button
                data-part="tab"
                data-value="react"
                style="padding: 0.4rem 0.85rem; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-canvas); color: var(--text-main); font-size: 0.82rem; font-weight: 600; cursor: pointer;"
              >
                ⚛️ React / Next.js (--react)
              </button>
              <button
                data-part="tab"
                data-value="html"
                style="padding: 0.4rem 0.85rem; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-canvas); color: var(--text-main); font-size: 0.82rem; font-weight: 600; cursor: pointer;"
              >
                🌐 Vanilla HTML (--html)
              </button>
              <button
                data-part="tab"
                data-value="rails"
                style="padding: 0.4rem 0.85rem; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-canvas); color: var(--text-main); font-size: 0.82rem; font-weight: 600; cursor: pointer;"
              >
                💎 Ruby on Rails (--rails)
              </button>
            </div>

            <!-- React Tab -->
            <div data-part="tabpanel" data-value="react">
              <pre
                class="code-viewer-pre"
                style="border-radius: 6px; font-size: 0.8rem; padding: 1rem; margin-bottom: 0.5rem;"><code>{`# Drops React 18/19 compound component into src/components/ui/dialog.jsx
npx nnui add dialog --react

// In your application:
import { Dialog, DialogModal } from './components/ui/dialog.jsx';

export function Example() {
  return (
    <DialogModal open={isOpen} onClose={() => setIsOpen(false)} title="Confirm Release">
      <p>You own the markup and internals!</p>
    </DialogModal>
  );
}`}</code></pre>
              <p
                style="font-size: 0.8rem; color: var(--text-muted); margin: 0;"
              >
                Exports raw primitives, typed compound subcomponents (<code
                  style="color: var(--ui-color-brand-500);">Dialog.Trigger</code
                >, <code style="color: var(--ui-color-brand-500);"
                  >Dialog.Content</code
                >, <code style="color: var(--ui-color-brand-500);"
                  >Dialog.Close</code
                >), and an editable composite modal.
              </p>
            </div>

            <!-- HTML Tab -->
            <div data-part="tabpanel" data-value="html">
              <pre
                class="code-viewer-pre"
                style="border-radius: 6px; font-size: 0.8rem; padding: 1rem; margin-bottom: 0.5rem;"><code>{`# Drops runnable HTML snippet & JS micro-enhancer into components/ui/dialog/
npx nnui add dialog --html

<!-- components/ui/dialog/dialog.html -->
<ui-dialog id="my-modal">
  <button data-part="trigger" type="button">Open Modal</button>
  <dialog data-part="dialog">
    <div data-part="panel">
      <h3>Platform Top-Layer Modal</h3>
      <p>Zero build step, 100% accessible.</p>
      <button data-part="close" type="button">Close</button>
    </div>
  </dialog>
</ui-dialog>

<script type="module" src="./ui-dialog.js"></script>`}</code></pre>
              <p
                style="font-size: 0.8rem; color: var(--text-muted); margin: 0;"
              >
                Includes standalone micro-enhancer and semantic Light-DOM HTML
                snippet. Open directly in any browser.
              </p>
            </div>

            <!-- Rails Tab -->
            <div data-part="tabpanel" data-value="rails">
              <pre
                class="code-viewer-pre"
                style="border-radius: 6px; font-size: 0.8rem; padding: 1rem; margin-bottom: 0.5rem;"><code>{`# Generates ERB partial, asset pipeline JS, and pins nnuikit in importmap.rb
npx nnui add dialog --rails

<%# app/views/pages/home.html.erb %>
<%= render "components/dialog", id: "confirm-modal", title: "Canary Rollout" do %>
  <p>Rendered with native Rails ERB and Light-DOM web components.</p>
<% end %>`}</code></pre>
              <p
                style="font-size: 0.8rem; color: var(--text-muted); margin: 0;"
              >
                Creates <code style="color: var(--ui-color-brand-500);"
                  >app/views/components/_dialog.html.erb</code
                > with <code style="color: var(--ui-color-brand-500);"
                  >local_assigns</code
                > and block yields, and configures Rails Importmaps automatically.
              </p>
            </div>
          </ui-tabs>
        </div>

        <!-- Global CSS Theme Callout Box -->
        <div
          data-ui="card"
          style="border: 1px solid var(--border-subtle); border-radius: 10px; padding: 1.5rem; background: var(--bg-card); margin-bottom: 1.5rem;"
        >
          <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;"
          >
            <div
              style="font-weight: 700; color: var(--text-main); font-size: 1rem; display: flex; align-items: center; gap: 0.5rem;"
            >
              <span>🎨</span>
              <span>Theme & Global CSS Tokens (Turnkey Copy-Paste)</span>
            </div>
            <a
              href="/tokens"
              data-ui="button"
              data-variant="secondary"
              data-size="xs"
              style="text-decoration: none; font-size: 0.78rem; padding: 0.35rem 0.85rem;"
            >
              Theme Studio & Exporter →
            </a>
          </div>
          <p
            style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1rem;"
          >
            NNUI-KIT provides standalone, W3C DTCG-compliant global CSS theme
            files. You can import them directly from the package, or copy-paste
            them straight into your product's <code
              style="color: var(--ui-color-brand-500);">globals.css</code
            > or <code style="color: var(--ui-color-brand-500);">theme.css</code
            >:
          </p>

          <pre
            class="code-viewer-pre"
            style="border-radius: 6px; font-size: 0.8rem; padding: 1rem; margin-bottom: 0.75rem;"><code>// Option 1: Full Universal Stylesheet (Cascade layers, tokens, reset & base primitives)
import 'nnuikit/globals.css';

// Option 2: Pure Theme Custom Properties (Zero-dependency CSS variables only)
import 'nnuikit/theme.css';</code></pre>

          <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0;">
