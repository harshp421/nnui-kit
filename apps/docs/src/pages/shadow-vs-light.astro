<!-- Client Script for Interactive Battle Lab & Simulation -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize Mock Shadow DOM Element
    const shadowHost = document.getElementById('shadow-dom-container');
    if (shadowHost) {
      let root = shadowHost.shadowRoot;
      if (!root) {
        root = shadowHost.attachShadow({ mode: 'open' });
      }
      root.innerHTML = `
        <style>
          .shadow-box {
            padding: 0.5rem;
            color: #71717a;
            font-family: inherit;
          }
          .shadow-btn {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            border: 1px solid #d4d4d8;
            background: #f4f4f5;
            color: #18181b;
            font-size: 0.875rem;
          }
        </style>
        <div class="shadow-box">
          <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.35rem; color: #52525b;">Role Selector (Shadow DOM)</label>
          <button type="button" class="shadow-btn">
            <span>Principal Architect</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <p style="font-size: 0.75rem; color: #ef4444; margin-top: 0.75rem;">
            🔒 Encapsulated in #shadow-root (open). External CSS rules and Tailwind classes cannot cross this threshold.
          </p>
        </div>
      `;
    }

    // 2. Tab Navigation inside Lab
    const labTabs = document.querySelectorAll('.lab-tab-btn');
    const ctrlPanels = document.querySelectorAll('.lab-ctrl-panel');

    labTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        labTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const testId = tab.dataset.test;

        ctrlPanels.forEach((p) => (p.style.display = 'none'));
        const activePanel = document.getElementById(`ctrl-section-${testId}`);
        if (activePanel) activePanel.style.display = 'block';
      });
    });

    // 3. CSS Preset Injection
    const cssPresetBtns = document.querySelectorAll('.css-preset-btn');
    const lightTargetBtn = document.querySelector('#light-dom-container .arena-btn');
    const activeCssDisplay = document.getElementById('active-css-display');

    const stylesMap = {
      default: {
        cssText: '',
        label: '.arena-btn { /* standard neutral theme */ }'
      },
      'tailwind-violet': {
        cssText: 'background-color: #7c3aed !important; color: #ffffff !important; border-radius: 12px !important; box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.3) !important; border: none !important;',
        label: '.arena-btn.bg-violet-600.text-white.rounded-xl.shadow-lg { background: #7c3aed; border-radius: 12px; }'
      },
      'tailwind-emerald': {
        cssText: 'border: 2px dashed #10b981 !important; color: #10b981 !important; font-family: monospace !important; background: transparent !important;',
        label: '.arena-btn.border-2.border-dashed.border-emerald-500.font-mono { border: 2px dashed #10b981; }'
      },
      cyberpunk: {
        cssText: 'background-color: #0f172a !important; color: #06b6d4 !important; border: 1px solid #06b6d4 !important; box-shadow: 0 0 12px #06b6d4 !important; font-weight: 800 !important; text-transform: uppercase !important;',
        label: '.arena-btn.cyberpunk { background: #0f172a; color: #06b6d4; box-shadow: 0 0 12px #06b6d4; }'
      }
    };

    cssPresetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        cssPresetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const styleKey = btn.dataset.style;
        const conf = stylesMap[styleKey];

        if (lightTargetBtn) {
          lightTargetBtn.style.cssText = conf.cssText;
        }
        if (activeCssDisplay) {
          activeCssDisplay.textContent = conf.label;
        }
      });
    });

    // 4. Form Submission Simulation
    const lightForm = document.getElementById('light-test-form');
    const lightOutput = document.getElementById('light-form-output');
    if (lightForm && lightOutput) {
      lightForm.addEventListener('submit', () => {
        const formData = new FormData(lightForm);
        const obj = {};
        for (const [k, v] of formData.entries()) {
          obj[k] = v;
        }
        lightOutput.textContent = JSON.stringify(obj, null, 2);
        lightOutput.style.color = '#10b981';
      });
    }

    // 5. Interactive Fit Quiz
    const calcBtn = document.getElementById('calc-fit-btn');
    const resultBox = document.getElementById('quiz-recommendation-box');
    const resultTitle = document.getElementById('quiz-result-title');
    const resultDesc = document.getElementById('quiz-result-desc');

    if (calcBtn && resultBox) {
      calcBtn.addEventListener('click', () => {
        const q1 = document.querySelector('input[name="q1"]:checked')?.value;
        const q2 = document.querySelector('input[name="q2"]:checked')?.value;
        const q3 = document.querySelector('input[name="q3"]:checked')?.value;

        resultBox.style.display = 'block';

        if (q1 === 'yes' || q2 === 'yes' || q3 === 'yes') {
          resultTitle.textContent = '✓ 100% Match: NNUI Light-DOM Architecture';
          resultTitle.style.color = '#10b981';
          resultBox.style.borderColor = 'rgba(16, 185, 129, 0.4)';
          resultBox.style.background = 'rgba(16, 185, 129, 0.08)';
          resultDesc.textContent =
            'Your requirements (Tailwind compatibility, native form serialization, or SSR safety) mean Shadow DOM will actively impede your team. NNUI-KIT delivers universal, multi-framework components without any styling or accessibility boundaries.';
        } else {
          resultTitle.textContent = 'ℹ Niche Match: Shadow DOM';
          resultTitle.style.color = '#f59e0b';
          resultBox.style.borderColor = 'rgba(245, 158, 11, 0.4)';
          resultBox.style.background = 'rgba(245, 158, 11, 0.08)';
          resultDesc.textContent =
            'Because you require an isolated, un-themeable third-party widget (e.g. an embeddable ad or isolated payment iframe), Shadow DOM encapsulation might be suitable.';
        }
      });
    }

    // 6. Reset Lab Button
    const resetBtn = document.getElementById('reset-lab-btn');
    if (resetBtn && lightTargetBtn) {
      resetBtn.addEventListener('click', () => {
        lightTargetBtn.style.cssText = '';
        const defaultBtn = document.querySelector('.css-preset-btn[data-style="default"]');
        if (defaultBtn) defaultBtn.click();
      });
    }
  });
</script>

