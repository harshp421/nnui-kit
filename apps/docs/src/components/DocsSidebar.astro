---
interface Props {
  activePath?: string;
}

const { activePath = "/docs" } = Astro.props;

const frameworks = [
  { name: "Next.js", path: "/docs/installation/next", badge: "React 19" },
  { name: "Vite (React)", path: "/docs/installation/vite", badge: "Popular" },
  { name: "Astro", path: "/docs/installation/astro", badge: "Zero JS" },
  { name: "Vue / Nuxt", path: "/docs/installation/vue", badge: "Vue 3" },
  { name: "SvelteKit", path: "/docs/installation/svelte", badge: "Svelte 5" },
  { name: "Remix", path: "/docs/installation/remix", badge: "v7" },
  { name: "Manual / CDN", path: "/docs/installation/manual", badge: "HTML" },
];
---

<aside class="docs-aside">
  <!-- Getting Started Group -->
  <div class="docs-aside-group">
    <div class="docs-aside-title">Getting Started</div>
    <a href="/docs" class={`docs-aside-link ${activePath === "/docs" ? "active" : ""}`}>
      Introduction
    </a>

    <!-- Installation Accordion & Subroutes -->
    <div style="margin: 0.25rem 0;">
      <a
        href="/docs/installation"
        class={`docs-aside-link ${activePath.startsWith("/docs/installation") ? "active" : ""}`}
        style="display: flex; align-items: center; justify-content: space-between;"
      >
        <span style="display: flex; align-items: center; gap: 0.4rem;">
          <span>📦</span>
          <span>Installation</span>
        </span>
        <span class="docs-version-pill" style="font-size: 0.65rem;">7 Stacks</span>
      </a>

      <!-- Nested Framework Sub-links (Always visible or highlighted) -->
      <div
        style="padding-left: 0.85rem; margin: 0.35rem 0 0.5rem 0.65rem; border-left: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 0.15rem;"
      >
        {
          frameworks.map((fw) => (
            <a
              href={fw.path}
              class={`docs-aside-sublink ${activePath === fw.path ? "active" : ""}`}
            >
              <span>{fw.name}</span>
              {activePath === fw.path && (
                <span style="font-size: 0.65rem; opacity: 0.7;">●</span>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <a href="/docs#mental-model" class="docs-aside-link">Three-Tier Architecture</a>
    <a
      href="/shadow-vs-light"
      class="docs-aside-link"
      style="display: flex; align-items: center; justify-content: space-between; color: #10b981; font-weight: 600;"
    >
      <span>Light vs Shadow DOM</span>
      <span
        style="font-size: 0.65rem; background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 1px 5px; border-radius: 9999px;"
        >WHY</span
      >
    </a>
    <a href="/docs#why-light-dom" class="docs-aside-link">Why Light-DOM?</a>
  </div>

  <!-- Crown Innovations Group -->
  <div class="docs-aside-group">
    <div class="docs-aside-title">Crown Innovations</div>
    <a href="/docs#persistence" class="docs-aside-link">Declarative Persistence</a>
    <a href="/docs#cross-tab" class="docs-aside-link">Cross-Tab Broadcast Sync</a>
    <a href="/docs#ai-introspection" class="docs-aside-link">AI Introspection Protocol</a>
    <a
      href="/llms"
      class="docs-aside-link"
      style="display: flex; align-items: center; justify-content: space-between; color: var(--ui-color-brand-500);"
    >
      <span>llms.txt (AI Spec)</span>
      <span
        style="font-size: 0.65rem; background: color-mix(in srgb, var(--ui-color-brand-500) 15%, transparent); color: var(--ui-color-brand-500); padding: 1px 5px; border-radius: 9999px; font-weight: 700;"
        >NEW</span
      >
    </a>
  </div>

  <!-- Design System & Tokens -->
  <div class="docs-aside-group">
    <div class="docs-aside-title">Design System & Tokens</div>
    <a href="/docs#typography-system" class="docs-aside-link">Typography System</a>
    <a href="/docs#layout-primitives" class="docs-aside-link">Layout & Status Primitives</a>
    <a href="/tokens" class="docs-aside-link">Theme Studio (Live)</a>
    <a href="/typography" class="docs-aside-link">Typography Studio ↗</a>
  </div>
</aside>

