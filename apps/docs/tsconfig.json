    "paths": {
      "nnui-kit": ["../../packages/nnui-kit/dist/index.d.ts"],
      "nnui-kit/client": ["../../packages/nnui-kit/dist/client.d.ts"],
      "nnui-kit/react": ["../../packages/nnui-kit/dist/react.d.ts"],
      "nnui-kit/*": ["../../packages/nnui-kit/*"],
