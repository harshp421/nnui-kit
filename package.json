{
  "name": "nnui-kit-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/docs && npm run dev",
    "dev:dashboard": "cd apps/dashboard && npm run dev",
    "dev:pkg": "cd packages/nnui-kit && npm run dev",
    "build:pkg": "cd packages/nnui-kit && npm run build",
    "build:docs": "cd apps/docs && npm run build",
    "build:dashboard": "cd apps/dashboard && npm run build",
    "build": "node scripts/build.js",
    "test": "node packages/nnui-kit/tests/run-all.js",
    "pack:check": "cd packages/nnui-kit && npm run pack:check",
    "publish:pkg": "cd packages/nnui-kit && npm publish"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.6",
    "@rollup/rollup-linux-x64-musl": "4.63.6"
  }
}
