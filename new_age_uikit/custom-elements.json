      "kind": "javascript-module",
      "path": "src/components/tabs/ui-tabs.js",
      "declarations": [
        {
          "kind": "class",
          "description": "WAI-ARIA APG compliant roving tabindex tabs in Light-DOM",
          "name": "UiTabs",
          "tagName": "ui-tabs",
          "customElement": true,
          "attributes": [
            {
              "name": "value",
              "type": { "text": "string" },
              "description": "Currently active tab value"
            },
            {
              "name": "orientation",
              "type": { "text": "'horizontal' | 'vertical'" },
              "default": "'horizontal'",
              "description": "Keyboard navigation direction"
            }
          ],
          "events": [
            {
              "name": "change",
              "description": "Fired when active tab changes",
              "type": { "text": "CustomEvent<{ value: string, previousValue: string }>" }
            }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "ui-tabs",
          "declaration": { "name": "UiTabs", "module": "src/components/tabs/ui-tabs.js" }
        }
      ]
    },
